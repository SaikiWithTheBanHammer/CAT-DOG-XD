local function loadFriends()
	if os.time() - friendsAt < 21600 and next(friends) then return end
	local ok, pages2 = pcall(function() return Players:GetFriendsAsync(LP.UserId) end)
	if not ok or not pages2 then return end
	local out, count = {}, 0
	repeat
		local okp, page = pcall(function() return pages2:GetCurrentPage() end)
		if not okp then break end
		for _, f in ipairs(page) do
			out[tostring(f.Id)] = { d = f.DisplayName or f.Username, n = f.Username }
			count += 1
		end
		if pages2.IsFinished or count >= 400 then break end
		if not pcall(function() pages2:AdvanceToNextPageAsync() end) then break end
	until false
	if next(out) then
		friends, friendsAt = out, os.time()
		writeJson(FRIENDS_FILE, { t = friendsAt, f = friends })
	end
end
local function robloxSearch(q)
	local ok, data = requestJSON("GET", "https://users.roblox.com/v1/users/search?keyword=" .. enc(q) .. "&limit=10")
	local out = {}
	if ok and type(data) == "table" and type(data.data) == "table" then
		for _, u in ipairs(data.data) do
			if u.id then out[#out + 1] = { id = tostring(u.id), d = tostring(u.displayName or u.name), n = tostring(u.name) } end
		end
	end
	return out
end

-- "ares" matches dsadaares432 / we2dwdAReS: plain substring, case-insensitive, display name OR username
local function matchScore(q, d, n)
	q = q:lower()
	local best
	for _, str in ipairs({ d or "", n or "" }) do
		local low = str:lower()
		if low ~= "" then
			local a = low:find(q, 1, true)
			if a then
				local sc = (low == q) and 3 or ((a == 1) and 2 or 1)
				if not best or sc > best then best = sc end
			end
		end
	end
	return best
end
local function consider(cands, id, d, n, tier, tag, q)
	if id == ME then return end
	local sc = matchScore(q, d, n)
	if not sc then return end
	local c = cands[id]
	if not c then
		c = { id = id, name = (d and d ~= "") and d or n or ("User " .. id), user = n, tier = tier, sc = sc, tags = {} }
		cands[id] = c
	else
		if tier < c.tier then c.tier = tier end
		if sc > c.sc then c.sc = sc end
		if (not c.user or c.user == "") and n then c.user = n end
	end
	c.tags[tag] = true
end
-- priority: 1 = history with me, 2 = friends, 3 = Saiki users / this server, 4 = rest of Roblox
local function searchLocal(q)
	local cands = {}
	for pid, e in pairs(index) do if e.l then consider(cands, pid, e.n, e.u, 1, "Recent", q) end end
	for id, f in pairs(friends) do consider(cands, id, f.d, f.n, 2, "Friend", q) end
	for _, p in ipairs(Players:GetPlayers()) do consider(cands, tostring(p.UserId), p.DisplayName, p.Name, 3, "In server", q) end
	for id, u in pairs(directory) do consider(cands, id, u.d, u.n, 3, "On Saiki", q) end
	return cands
end
local HINT = "Search your history, friends, Saiki users, this server and all of Roblox."
local function renderResults(cands, pending)
	clearList(resultsList)
	local arr = {}
	for _, c in pairs(cands) do arr[#arr + 1] = c end
	table.sort(arr, function(a, b)
		if a.tier ~= b.tier then return a.tier < b.tier end
		if a.sc ~= b.sc then return a.sc > b.sc end
		return a.name:lower() < b.name:lower()
	end)
	local heads = { "From your history", "Friends", "Saiki users & this server", "Roblox results" }
	local lastTier, order = 0, 0
	for i, c in ipairs(arr) do
		if i > 40 then break end
		if c.tier ~= lastTier then lastTier = c.tier; order += 1; addHeader(resultsList, heads[c.tier], order) end
		order += 1
		local tags = {}
		for _, t in ipairs({ "Recent", "Friend", "In server", "On Saiki", "Roblox" }) do if c.tags[t] then tags[#tags + 1] = t end end
		local who = (c.user and c.user ~= "") and ("@" .. c.user .. "  •  ") or ""
		makeRow(resultsList, { id = c.id, name = c.name, user = c.user, sub = who .. table.concat(tags, " • "),
			unread = isUnread(c.id) }, order)
	end
	if #arr == 0 and not pending then addEmpty(resultsList, "No matches.", 1) end
	if pending then addEmpty(resultsList, "Searching Roblox…", 999) end
end
local searchTok, lastApi = 0, 0
local function runSearch()
	searchTok += 1
	local tok = searchTok
	local q = searchBox.Text:match("^%s*(.-)%s*$") or ""
	if q == "" then clearList(resultsList); addEmpty(resultsList, HINT, 1); return end
	task.delay(0.2, function() -- debounce typing
		if tok ~= searchTok or not alive then return end
		local cands = searchLocal(q)
		local wantApi = #q >= 3 and REQUEST ~= nil
		renderResults(cands, wantApi)
		if not wantApi then return end
		task.delay(0.5, function()
			if tok ~= searchTok or not alive then return end
			local w = 1.3 - (os.clock() - lastApi) -- stay under Roblox's rate limit
			if w > 0 then task.wait(w) end
			if tok ~= searchTok or not alive then return end
			lastApi = os.clock()
			for _, r in ipairs(robloxSearch(q)) do consider(cands, r.id, r.d, r.n, 4, "Roblox", q) end
			if tok ~= searchTok or not alive then return end
			renderResults(cands, false)
		end)
	end)
end
