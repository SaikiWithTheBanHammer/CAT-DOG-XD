				if s == dmStream and n % 2 == 0 then pollReactions(s.rpath, dmAuth, DM_FIREBASE_DB, views.dm) end
			end
			if n % 3 == 1 then pollInbox() end                 -- ~7.5s: ONE small request tells me who messaged
			if n == 2 and not legacyDone then discoverLegacy() end -- once per install
