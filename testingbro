local function buildServer()
	clearList(serverList)
	local arr = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local id = tostring(p.UserId)
			local tags = {}
			if friends[id] then tags[#tags + 1] = "Friend" end
			tags[#tags + 1] = directory[id] and "On Saiki" or "Not on Saiki yet"
			arr[#arr + 1] = { id = id, name = p.DisplayName, user = p.Name, sub = table.concat(tags, " • "), unread = isUnread(id),
				rank = (index[id] and 4 or 0) + (friends[id] and 2 or 0) + (directory[id] and 1 or 0) }
		end
	end
	table.sort(arr, function(a, b)
		if a.rank ~= b.rank then return a.rank > b.rank end
		return a.name:lower() < b.name:lower()
	end)
	if #arr == 0 then addEmpty(serverList, "No other players in this server.", 1); return end
	for i, e in ipairs(arr) do makeRow(serverList, e, i) end
end

