local auth, dmAuth = { token = nil, refresh = nil, uid = nil }, { token = nil, refresh = nil, uid = nil }

local function requestJSON(method, url, body, headers)
	if not REQUEST then return false, nil, "no request function" end
	local opts = { Url = url, Method = method, Headers = { ["Content-Type"] = "application/json" } }
	if headers then for k, v in pairs(headers) do opts.Headers[k] = v end end
	if body ~= nil then opts.Body = (type(body) == "string") and body or HttpService:JSONEncode(body) end
	local ok, res = pcall(REQUEST, opts)
	if not ok or not res then return false, nil, tostring(res) end
	local code = tonumber(res.StatusCode or res.Status or 0) or 0
	local raw = res.Body or res.body or ""
	local decoded
	if raw ~= "" then pcall(function() decoded = HttpService:JSONDecode(raw) end) end
	return code >= 200 and code < 300, decoded, raw, code
end

local function dbURL(base, path, token, extra)
	local url, q = base .. path .. ".json", {}
	if token and token ~= "" then q[#q + 1] = "auth=" .. enc(token) end
	if extra and extra ~= "" then q[#q + 1] = extra end
	if #q > 0 then url = url .. "?" .. table.concat(q, "&") end
	return url
end

local function firebaseAuth(target)
	local key = (target == dmAuth) and DM_FIREBASE_API_KEY or FIREBASE_API_KEY
	local ok, data, raw = requestJSON("POST",
		"https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. key, { returnSecureToken = true })
	if ok and type(data) == "table" and data.idToken then
		target.token, target.refresh, target.uid = data.idToken, data.refreshToken, data.localId
		return true
	end
	warn("[SAIKI RECHAT] Firebase auth failed: " .. tostring(raw))
	return false
end

local function refreshAuth(target)
	if not target.refresh then return firebaseAuth(target) end
	local key = (target == dmAuth) and DM_FIREBASE_API_KEY or FIREBASE_API_KEY
	local ok, data = requestJSON("POST", "https://securetoken.googleapis.com/v1/token?key=" .. key,
		"grant_type=refresh_token&refresh_token=" .. enc(target.refresh),
		{ ["Content-Type"] = "application/x-www-form-urlencoded" })
	if ok and type(data) == "table" and data.id_token then
		target.token = data.id_token
		target.refresh = data.refresh_token or target.refresh
		return true
	end
	return firebaseAuth(target)
end

local function dbRequest(method, path, body, target, base, extra)
	target, base = target or auth, base or FIREBASE_DB
	if not target.token and not firebaseAuth(target) then return false, nil, "auth unavailable" end
	local ok, data, raw, code = requestJSON(method, dbURL(base, path, target.token, extra), body)
	if code == 401 and refreshAuth(target) then
		ok, data, raw, code = requestJSON(method, dbURL(base, path, target.token, extra), body)
	end
	return ok, data, raw, code
end

----------------------------------------------------------------- persistent cache + stickers
local function ensureFolder(path)
	if not makefolder then return end
	local cur = ""
	for part in string.gmatch(path, "[^/]+") do
		cur = (cur == "") and part or (cur .. "/" .. part)
		if not (isfolder and isfolder(cur)) then pcall(makefolder, cur) end
	end
end
ensureFolder(CACHE); ensureFolder(STICKER_CACHE)

local function cachedAsset(url, path)
	if not (writefile and isfile and getcustomasset) then return nil end
	if not isfile(path) then
		local ok, data = pcall(function()
			local r = REQUEST({ Url = url, Method = "GET" })
			local c = r and tonumber(r.StatusCode or r.Status or 0) or 0
			if c >= 200 and c < 300 then return r.Body or r.body end
		end)
		if ok and type(data) == "string" and #data > 0 then pcall(writefile, path, data) end
	end
	if isfile(path) then
		local ok, asset = pcall(getcustomasset, path)
		if ok then return asset end
	end
	return nil
end

-- limit simultaneous downloads (lag protection)
local dlActive = 0
local function limited(fn)
	while alive and dlActive >= 3 do task.wait(0.05) end
	dlActive += 1
	local ok, res = pcall(fn)
	dlActive -= 1
	return ok and res or nil
end

local repoSet = {}
