-- ===== background sync (all cheap) =====
-- fetch only the new messages of one conversation, straight into its local file
local function fetchNew(pid, inboxTs)
	if dm.partner == pid and dmStream then -- open thread keeps its own cursor and dedupe
		pollStream(dmStream, dmHandler)
		local ee = index[pid]
		if ee then ee.it = inboxTs end
		return
	end
	local msgs = loadConv(pid)
	local lastKey = msgs[#msgs] and msgs[#msgs].k
	local extra = lastKey and ('orderBy="$key"&startAt="' .. lastKey .. '"') or ('orderBy="$key"&limitToLast=' .. CONFIG.HISTORY)
	local ok, data = dbRequest("GET", "/dm/" .. pairKey(ME, pid), nil, dmAuth, DM_FIREBASE_DB, extra)
	if not ok or type(data) ~= "table" then return end
	local rows = {}
	for k, v in pairs(data) do if type(v) == "table" then rows[#rows + 1] = { k = tostring(k), v = v } end end
	table.sort(rows, function(a, b) return a.k < b.k end)
	local have, added = {}, false
	for _, st in ipairs(msgs) do have[st.k] = true end
	for _, it in ipairs(rows) do
		local uid = tostring(it.v.uid or "")
		if not have[it.k] and (uid == ME or uid == pid) and not banned[tonumber(uid)] then
			local st = toStored(it.k, it.v)
			if st then msgs[#msgs + 1] = st; added = true; touchIndex(pid, st) end
		end
	end
	local e = index[pid] or touchIndex(pid, nil)
	e.it = inboxTs
	if added then saveConv(pid, msgs) end
	resolveName(pid)
	indexDirty = true
end

local function pollInbox()
	local ok, data = dbRequest("GET", "/dminbox/" .. ME, nil, dmAuth, DM_FIREBASE_DB)
	if not ok or type(data) ~= "table" then return end
	local work = 0
	for pid, v in pairs(data) do
		if type(v) == "table" and tostring(pid):match("^%d+$") then
			local ts = tonumber(v.ts) or 0
			local e = index[tostring(pid)]
			if (not e or ts > (e.it or 0)) and work < 5 then
				work += 1
				fetchNew(tostring(pid), ts)
			end
		end
	end
	refreshUnread()
end

-- once per install: find DM threads that already exist (older script versions had no inbox pings)
local function discoverLegacy()
	local ok, data = dbRequest("GET", "/dm", nil, dmAuth, DM_FIREBASE_DB, "shallow=true")
	if not ok or type(data) ~= "table" then return end
	local count = 0
	for key in pairs(data) do
		local a, b = tostring(key):match("^(%d+)_(%d+)$")
		local pid = a and ((a == ME and b) or (b == ME and a))
		if pid and not index[pid] and count < 25 then
			count += 1
			local ok2, msgs = dbRequest("GET", "/dm/" .. enc(key), nil, dmAuth, DM_FIREBASE_DB, 'orderBy="$key"&limitToLast=1')
			if ok2 and type(msgs) == "table" then
				for k, v in pairs(msgs) do
					local st = type(v) == "table" and toStored(tostring(k), v)
					if st then
						local e = touchIndex(pid, st)
						e.r = e.l -- old history starts as "read"
						resolveName(pid)
					end
				end
			end
		end
	end
	legacyDone, indexDirty = true, true
	refreshUnread()
end

