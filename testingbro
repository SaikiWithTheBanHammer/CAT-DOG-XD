local function isImageName(n)
	n = n:lower()
	return n:match("%.png$") or n:match("%.jpg$") or n:match("%.jpeg$") or n:match("%.webp$") or n:match("%.gif$")
end
-- a sticker reference is "Repo/file.png"; only our own repos are accepted
local function validSticker(s)
	if type(s) ~= "string" or #s > 100 then return nil end
	local repo, name = s:match("^([^/]+)/([^/\\]+)$")
	if repo and repoSet[repo] and isImageName(name) and not name:find("%c") then return s end
	return nil
end
local function stickerAsset(ref)
	local repo, name = ref:match("^([^/]+)/(.+)$")
	if not repo then return nil end
	local url = "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. repo .. "/main/" .. enc(name)
	local path = STICKER_CACHE .. "/" .. safeName(repo) .. "_" .. safeName(name)
	return limited(function() return cachedAsset(url, path) end)
end

local listingMem = {}
local function getListing(repo)
	if listingMem[repo] then return listingMem[repo] end
	local lp = STICKER_CACHE .. "/" .. safeName(repo) .. "_list.json"
	local disk
	pcall(function()
		if isfile and readfile and isfile(lp) then
			local d = HttpService:JSONDecode(readfile(lp))
			if type(d) == "table" and type(d.names) == "table" then disk = d end
		end
	end)
	if disk and (os.time() - (disk.t or 0)) < CONFIG.STICKER_LIST_TTL then
		listingMem[repo] = disk.names
		return disk.names
	end
	local ok, data = requestJSON("GET", "https://api.github.com/repos/" .. GITHUB_OWNER .. "/" .. repo .. "/contents",
		nil, { Accept = "application/vnd.github+json" })
	if ok and type(data) == "table" then
		local names = {}
		for _, it in ipairs(data) do
			if it.type == "file" and isImageName(it.name) then names[#names + 1] = it.name end
		end
		table.sort(names)
		pcall(function() if writefile then writefile(lp, HttpService:JSONEncode({ t = os.time(), names = names })) end end)
		listingMem[repo] = names
		return names
	end
	if disk then listingMem[repo] = disk.names; return disk.names end -- offline: use stale list
	return nil
end

