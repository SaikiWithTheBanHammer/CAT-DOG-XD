-- pull reactions for the latest messages of a stream and push them into the view
local function pollReactions(path, tAuth, base, view)
	if not path then return end
	local ok, data = dbRequest("GET", path, nil, tAuth, base, 'orderBy="$key"&limitToLast=60')
	if not ok then return end
	data = (type(data) == "table") and data or {}
	for key, map in pairs(data) do
		if type(map) == "table" then
			local good = {}
			for uid, e in pairs(map) do
				if type(e) == "string" and ALLOWED_REACT[e] and not banned[tonumber(uid)] then good[tostring(uid)] = e end
			end
			view.setReactions(tostring(key), good)
		end
	end
	local stale = {}
	for key in pairs(view.reacts) do if data[key] == nil then stale[#stale + 1] = key end end
	for _, key in ipairs(stale) do view.setReactions(key, {}) end
end

