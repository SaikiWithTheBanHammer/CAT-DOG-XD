local function readJson(path)
	local ok, d = pcall(function()
		if isfile and readfile and isfile(path) then return HttpService:JSONDecode(readfile(path)) end
	end)
	return ok and d or nil
end
local function writeJson(path, data)
	pcall(function() if writefile then writefile(path, HttpService:JSONEncode(data)) end end)
end
local function pairKey(a, b) return math.min(tonumber(a), tonumber(b)) .. "_" .. math.max(tonumber(a), tonumber(b)) end
local function ago(ms)
	if not ms or ms <= 0 then return "" end
	local d = os.time() - math.floor(ms / 1000)
	if d < 60 then return "now" elseif d < 3600 then return math.floor(d / 60) .. "m"
	elseif d < 86400 then return math.floor(d / 3600) .. "h" else return math.floor(d / 86400) .. "d" end
end

