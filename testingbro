local function kick(msg) pcall(function() LP:Kick(msg) end) end

-- hashed hardware id, computed locally and only compared with the ban list (never sent anywhere)
local function myHwidHash()
	local fn = gethwid or getmacaddress or getdeviceid
	if not fn then return nil end
	local ok, raw = pcall(fn)
	if not ok or type(raw) ~= "string" or raw == "" then return nil end
	raw = raw:lower():gsub("%s+", "")
	local hasher = crypt and crypt.hash
	if hasher then
		local ok2, res = pcall(hasher, raw, "sha256")
		if ok2 and type(res) == "string" then return res:lower() end
	end
	return nil
end
local MY_HWID = myHwidHash()

local function loadBanList()
	if CONFIG.BAN_LIST_URL == "" then return end
	local ok, data = requestJSON("GET", CONFIG.BAN_LIST_URL)
	if ok and type(data) == "table" then
		if type(data.ids) == "table" then
			for _, id in ipairs(data.ids) do banned[tonumber(id) or id] = true end
		end
		if type(data.hwids) == "table" then
			for _, h in ipairs(data.hwids) do bannedHwid[tostring(h):lower()] = true end
		end
	end
end
local function isBanned() return banned[LP.UserId] or (MY_HWID and bannedHwid[MY_HWID]) or false end

-- baseline of the 4 credentials taken at launch
local base = { name = LP.Name, id = LP.UserId, dn = LP.DisplayName, age = LP.AccountAge }

-- check 1: did any of the 4 values change locally since launch?
local function localDrift()
	return LP.Name ~= base.name or LP.UserId ~= base.id or LP.DisplayName ~= base.dn or LP.AccountAge ~= base.age
end

-- extra anchors: Roblox's own player lookups don't use the properties a spoofer edits
local function anchorsOk()
	local ok1, p = pcall(function() return Players:GetPlayerByUserId(LP.UserId) end)
	if not ok1 or p ~= LP then return false end
	local ok2, q = pcall(function() return Players:FindFirstChild(LP.Name) end)
	if ok2 and q ~= LP then return false end
	return true
end

-- check 2: compare all 4 with Roblox's API. true = matches, false = mismatch, nil = couldn't check
local function apiCheck(withDisplay)
	local ok, d = requestJSON("GET", "https://users.roblox.com/v1/users/" .. tostring(LP.UserId))
	if not ok or type(d) ~= "table" or not d.id then return nil end
	if tonumber(d.id) ~= LP.UserId then return false end
	if tostring(d.name):lower() ~= LP.Name:lower() then return false end
	if withDisplay and tostring(d.displayName) ~= LP.DisplayName then return false end
	local okT, dt = pcall(DateTime.fromIsoDate, tostring(d.created))
	if okT and dt then
		local days = math.floor((os.time() - dt.UnixTimestamp) / 86400)
		if math.abs(days - LP.AccountAge) > CONFIG.AGE_TOLERANCE_DAYS then return false end
	end
	return true
end

-- returns "ok" | "spoof" (definite) | "mismatch" (API disagrees, needs 2 strikes) | "unknown"
local function checkIdentity(withDisplay)
	if localDrift() or not anchorsOk() then return "spoof" end
	if not REQUEST then return "unknown" end
	local r = apiCheck(withDisplay)
	if r == nil then return "unknown" end
	return r and "ok" or "mismatch"
end

-- startup gate: nothing is built if this fails
loadBanList()
if isBanned() then kick(KICK_BAN); do return end end
do
	local strikes, verdict = 0, "unknown"
	for _ = 1, 4 do
		verdict = checkIdentity(true) -- full 4-field API comparison at launch
		if verdict == "spoof" then kick(KICK_SPOOF); do return end end
		if verdict == "mismatch" then
			strikes += 1
			if strikes >= 2 then kick(KICK_SPOOF); do return end end
		elseif verdict == "ok" then
			break
		end
		task.wait(2)
	end
	if verdict ~= "ok" then
		warn("[SAIKI RECHAT] Roblox API identity check unavailable; continuing without it.")
		if CONFIG.REQUIRE_API then return end
	end
end

