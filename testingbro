	function self.sendSticker(ref) return fire({ stk = ref }) end

	-- ===== reactions =====
	local function renderReactions(key)
		local item = self.items[key]
		if not item then return end
		local map = self.reacts[key] or {}
		local counts, order = {}, {}
		for _, e in pairs(map) do
			if not counts[e] then counts[e] = 0; order[#order + 1] = e end
			counts[e] += 1
		end
		table.sort(order)
		local mineE = map[ME]
		local parts = {}
		for _, e in ipairs(order) do parts[#parts + 1] = e .. counts[e] end
		local sig = table.concat(parts, ",") .. "|" .. tostring(mineE)
		if item.sig == sig then return end -- nothing changed, skip rebuild
		item.sig = sig
		if item.reactBox then item.reactBox:Destroy(); item.reactBox = nil end
		if #order == 0 then return end
		local holder = new("Frame", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
			LayoutOrder = 4, Parent = item.col }, {
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
				SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = item.mine and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left }),
		})
		for i, e in ipairs(order) do
			local chip = new("TextButton", { Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i,
				BackgroundColor3 = (mineE == e) and T.accA or WHITE, BackgroundTransparency = (mineE == e) and 0.35 or 0.9,
				Text = e .. " " .. counts[e], Font = T.fontB, TextSize = 12, TextColor3 = T.text, AutoButtonColor = false,
				Parent = holder }, { corner(11), pad(0, 8) })
			chip.Activated:Connect(function() self.react(key, e) end)
		end
		item.reactBox = holder
	end
	-- toggle my reaction on a message (one reaction per person, tap the same one again to remove)
	function self.react(key, emoji)
		local map = self.reacts[key] or {}
		local newE = (map[ME] ~= emoji) and emoji or nil
		map[ME] = newE
		self.reacts[key] = map
		self.mineLock[key] = os.clock() + 4 -- ignore stale poll data for my own reaction briefly
		renderReactions(key)
		if onReact then onReact(key, newE) end
	end
	function self.setReactions(key, map)
		map = map or {}
		if (self.mineLock[key] or 0) > os.clock() then map[ME] = (self.reacts[key] or {})[ME] end
		self.reacts[key] = map
		renderReactions(key)
	end

	-- ===== long-press (touch/mouse hold) or right-click opens the message menu =====
	local function attachPress(obj, item)
		obj.InputBegan:Connect(function(input)
			local ut = input.UserInputType
			if ut == Enum.UserInputType.MouseButton2 then openMenu(self, item, obj); return end
			if ut ~= Enum.UserInputType.MouseButton1 and ut ~= Enum.UserInputType.Touch then return end
			local start = input.Position
			task.delay(0.45, function()
				if not alive or not obj.Parent then return end
				local st = input.UserInputState
				if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then return end
				if (input.Position - start).Magnitude > 12 then return end -- finger moved = scrolling
				openMenu(self, item, obj)
			end)
		end)
	end

	function self.add(m)
		local mine = (tostring(m.uid) == ME)
		local key = tostring(m.key or ("l" .. (self.n + 1)))
		local newGroup = not (self.lastUid == m.uid and (os.clock() - self.lastTs) < CONFIG.GROUP_WINDOW)
		self.lastUid, self.lastTs = m.uid, os.clock()
		self.n += 1
		local atBottom = list.CanvasPosition.Y >= list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y - 40
		local w = list.AbsoluteSize.X
		if w < 50 then w = 480 end
		local maxW = math.max(140, math.floor(w * 0.62))

		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, LayoutOrder = self.n, Parent = list }, {
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
				HorizontalAlignment = mine and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left,
				Padding = UDim.new(0, 8) }),
			new("UIPadding", { PaddingTop = UDim.new(0, newGroup and 8 or 0) }),
		})
		row:SetAttribute("k", key)
		local avW = (mine and not CONFIG.SHOW_OWN_AVATAR) and 0 or 30
		local av = new("Frame", { Size = UDim2.fromOffset(avW, 30), BackgroundTransparency = 1,
			LayoutOrder = mine and 2 or 1, Parent = row })
		if newGroup and avW > 0 then
			new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88,
				Image = thumb(m.uid), Parent = av }, { corner(15) })
		end
		local col = new("Frame", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
			LayoutOrder = mine and 1 or 2, Parent = row }, {
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2),
				HorizontalAlignment = mine and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left }),
		})
		if newGroup and not mine then
			new("TextLabel", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
				Text = m.name, Font = T.fontB, TextSize = 12, TextColor3 = T.mut, LayoutOrder = 1, Parent = col },
				{ new("UIPadding", { PaddingLeft = UDim.new(0, 4) }) })
		end

		-- quoted message (reply), drawn inside the bubble (text) or as a small pill above a sticker
		local function makeQuote(par, order)
			local q = new("Frame", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = order,
				BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, Parent = par },
				{ corner(8), pad(4, 8), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })
			new("TextLabel", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
				Text = m.reply.n, Font = T.fontB, TextSize = 11, TextColor3 = mine and WHITE or T.accB, LayoutOrder = 1, Parent = q })
			new("TextLabel", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
				Text = m.reply.t, TextWrapped = true, Font = T.font, TextSize = 12, TextColor3 = T.text,
				TextTransparency = 0.25, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = q },
				{ new("UISizeConstraint", { MaxSize = Vector2.new(math.max(100, maxW - 30), math.huge) }) })
		end

		local target
		if m.stk then
			if m.reply then makeQuote(col, 2) end
			target = new("ImageLabel", { Size = UDim2.fromOffset(112, 112), BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.94, Image = "", ScaleType = Enum.ScaleType.Fit, LayoutOrder = 3, Parent = col },
				{ corner(14) })
			task.spawn(function()
				local a = stickerAsset(m.stk)
				if not (alive and target.Parent) then return end
				if a then
					target.Image = a
					target.BackgroundTransparency = 1
				else
					new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "[sticker]",
						Font = T.font, TextSize = 13, TextColor3 = T.mut, Parent = target })
				end
			end)
		else
			target = new("Frame", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 3,
				BackgroundColor3 = WHITE, BackgroundTransparency = mine and 0.05 or 0.9, Parent = col },
				{ corner(16), pad(8, 12), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
					HorizontalAlignment = mine and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left }) })
			if mine then new("UIGradient", { Color = ColorSequence.new(T.accA, T.accB), Rotation = 25, Parent = target })
			else stroke(0.9).Parent = target end
			if m.reply then makeQuote(target, 1) end
			new("TextLabel", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1,
				Text = m.text, TextWrapped = true, RichText = false, Font = T.font, TextSize = 15, TextColor3 = T.text,
				TextXAlignment = mine and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = target },
				{ new("UISizeConstraint", { MaxSize = Vector2.new(maxW, math.huge) }) })
		end
		local sc = new("UIScale", { Scale = 0.88, Parent = target })
		tween(sc, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)

		local item = { key = key, mine = mine, uid = m.uid, name = m.name, text = m.text, stk = m.stk, col = col }
		self.items[key] = item
		attachPress(target, item)
		if self.reacts[key] then renderReactions(key) end

		self.rows[#self.rows + 1] = row
		if #self.rows > CONFIG.MAX_MESSAGES then
			local old = table.remove(self.rows, 1)
			local k = old:GetAttribute("k")
			if k then self.items[k] = nil; self.reacts[k] = nil; self.mineLock[k] = nil end
			old:Destroy()
		end
		if atBottom or mine then
			task.defer(function()
				RunService.Heartbeat:Wait()
				if alive then list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y)) end
			end)
		end
	end

	function self.notice(text)
		self.n += 1
		self.lastUid = nil
		self.rows[#self.rows + 1] = new("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
			Text = text, Font = T.font, TextSize = 12, TextColor3 = T.mut, LayoutOrder = self.n, Parent = list })
	end
	function self.clear()
		for _, r in ipairs(self.rows) do r:Destroy() end
		self.rows, self.lastUid, self.n = {}, nil, 0
		self.items, self.reacts, self.mineLock = {}, {}, {}
		self.clearReply()
	end

	self.root, self.box, self.stickerBtn = root, box, stkBtn
	return self
end

