-- names: /profiles first, Roblox lookup as fallback
local function resolve(e)
	local nm = names[e.id]
	if not nm then
		local pl = Players:GetPlayerByUserId(tonumber(e.id) or 0)
		if pl then nm = { dn = pl.DisplayName, un = pl.Name, keep = true, t = os.time() } end
		if not nm then
			local okp, pd = FS.req("GET", "/profiles/" .. e.id)
			if okp and type(pd) == "table" and pd.username then
				if type(pd.displayName) == "string" and pd.displayName ~= "" and pd.displayName ~= pd.username then
					nm = { dn = pd.displayName, un = pd.username, keep = true, t = os.time() }
				else
					nm = apiName(e.id) -- profile has no separate display name: ask Roblox
					if nm then nm.keep, nm.t = true, os.time() else nm = { dn = pd.username, un = pd.username } end
				end
			end
		end
		if not nm then
			nm = apiName(e.id)
			if nm then nm.keep, nm.t = true, os.time() end
		end
		if not nm then
			local oku, un = pcall(function() return Players:GetNameFromUserIdAsync(tonumber(e.id)) end)
			if oku and un then nm = { dn = un, un = un } else nm = { dn = "User " .. e.id, un = "" } end
		end
		if nm.keep then namesDirty = true end
		names[e.id] = nm
	end
	e.dn, e.un = nm.dn, nm.un
end

-- takes the top LIMIT of the sorted list and fills the rows in one by one, #1 first
function showBoard()
	if not full then return end
	gen = gen + 1
	local my = gen
	local list = {}
	for i = 1, math.min(LIMIT, #full) do list[i] = { id = full[i].id, c = full[i].c } end
	board, myRank, myC = {}, nil, nil
	for i, e in ipairs(list) do if e.id == ME then myRank, myC = i, e.c end end
	pendVal = LIMIT
	loading = true
	render()

	-- a few workers look names up in rank order, the rows are then added strictly top to bottom
	local nextI = 0
	local function worker()
		while my == gen do
			nextI = nextI + 1
			local e = list[nextI]
			if not e then return end
			resolve(e)
		end
	end
	for _ = 1, 6 do task.spawn(worker) end

	for i, e in ipairs(list) do
		local t0 = os.clock()
		while not e.dn and os.clock() - t0 < 12 and my == gen do task.wait(0.05) end
		if my ~= gen then return end
		if not e.dn then e.dn, e.un = "User " .. e.id, "" end
		if FS.cache then FS.cache[e.id] = { c = e.c, t = os.clock() } end
		if i == 1 then
			for _, c in ipairs(sc:GetChildren()) do
				if c:IsA("GuiObject") and c.LayoutOrder == 5 then c:Destroy() end
			end
		end
		board[i] = e
		makeRow(e, i)
		if hdrRight and hdrRight.Parent then hdrRight.Text = "loading " .. i .. "/" .. #list end
	end
	if my ~= gen then return end
	loading, stamp = false, os.clock()
	saveNames()
	render()
end

function load()
	if loading then return end
	loading = true
	errMsg = nil
	render()
	local ok, data, raw, code = FS.req("GET", "/followers")
	if not ok then
		errMsg = "Couldn't load the leaderboard (" .. tostring(code) .. "). Check the sxikiflowsys rules are published."
		loading = false
		render()
		return
	end
	local list = {}
	if type(data) == "table" then
		for id, ups in pairs(data) do
			if type(ups) == "table" and tostring(id):match("^%d+$") then
				local n = 0
				for _ in pairs(ups) do n = n + 1 end
				if n > 0 then list[#list + 1] = { id = tostring(id), c = n } end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.c ~= b.c then return a.c > b.c end
		return a.id < b.id
	end)
	full = list
	showBoard()
end

