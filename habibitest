				BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.mut, CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel }, {
				new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
			local status = new("TextLabel", { Position = UDim2.fromOffset(10, 100), Size = UDim2.fromOffset(310, 40), BackgroundTransparency = 1,
				Text = "Loading…", TextWrapped = true, Font = T.font, TextSize = 13, TextColor3 = T.mut, ZIndex = 5, Parent = panel })

			local function addRow(rid, dn, un, i)
				local r = new("TextButton", { Size = UDim2.new(1, -6, 0, 46), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94, Text = "",
					AutoButtonColor = false, LayoutOrder = i, Parent = list }, { corner(12) })
				new("ImageLabel", { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.88, Image = thumb(rid), Parent = r }, { corner(17) })
				new("TextLabel", { Position = UDim2.fromOffset(52, 5), Size = UDim2.new(1, -62, 0, 18), BackgroundTransparency = 1, Text = dn,
					Font = T.fontB, TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
				new("TextLabel", { Position = UDim2.fromOffset(52, 24), Size = UDim2.new(1, -62, 0, 15), BackgroundTransparency = 1,
					Text = (un ~= "") and ("@" .. un) or "", Font = T.font, TextSize = 11, TextColor3 = T.mut,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
				r.Activated:Connect(function() T.openProfile(rid, dn, un) end) -- opens that person's profile
			end

			local CAP = 150
			local function load(kind)
				listGen = listGen + 1
				local my = listGen
				for k, b in pairs(tabs) do
					local sel = (k == kind)
					tween(b, 0.2, { BackgroundColor3 = sel and T.accA or WHITE, BackgroundTransparency = sel and 0 or 0.9 })
					b.TextColor3 = sel and WHITE or T.text
				end
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("GuiObject") then c:Destroy() end
				end
				status.Text, status.Visible = "Loading…", true
				task.spawn(function()
					local items = {} -- { id, displayName | nil, username }
					if id == ME and not FS.loadedF and not FS.loading then FS.loadMine() end
					if kind == "followers" then
						if id == ME then
							for _, e in ipairs(FS.followers) do items[#items + 1] = { e.id, e.n, e.u } end
						else
							local ok, data = FS.req("GET", "/followers/" .. id)
							if not ok then status.Text = "Couldn't load the followers list."; return end
							local tmp = {}
							if type(data) == "table" then
								for _, r in pairs(data) do
									if type(r) == "table" and tonumber(r.rid) then
										tmp[#tmp + 1] = { string.format("%.0f", tonumber(r.rid)), tostring(r.dn or r.un or "?"), tostring(r.un or ""), tonumber(r.ts) or 0 }
									end
								end
							end
							table.sort(tmp, function(a, b) return a[4] > b[4] end)
							items = tmp
						end
					else
						if id == ME then
							for tid, e in pairs(FS.following) do items[#items + 1] = { tid, e.n, e.u } end
							table.sort(items, function(a, b) return tostring(a[2]):lower() < tostring(b[2]):lower() end)
						else
							local ok, data = FS.req("GET", "/following/" .. id)
							if not ok then status.Text = "Couldn't load the following list."; return end
							if type(data) == "table" then
								for tid, r in pairs(data) do
									if tostring(tid):match("^%d+$") then items[#items + 1] = { tostring(tid), nil, nil, type(r) == "table" and tonumber(r.ts) or 0 } end
								end
							end
							table.sort(items, function(a, b) return (a[4] or 0) > (b[4] or 0) end)
						end
					end
					if my ~= listGen or not list.Parent then return end
					tabs[kind].Text = ((kind == "followers") and "Followers" or "Following") .. "  ·  " .. #items
					if #items == 0 then
						status.Text = (kind == "followers") and "No followers yet." or "Not following anyone yet."
						return
					end
					status.Visible = false
					-- names that are not known yet are looked up by a few workers, rows are still added strictly in order
					local nextI = 0
					for _ = 1, 5 do
						task.spawn(function()
							while my == listGen do
								nextI = nextI + 1
								local it = items[nextI]
								if not it or nextI > CAP then return end
								if not it[2] then it[2], it[3] = lookup(it[1]) end
							end
						end)
					end
					for i, it in ipairs(items) do
						if i > CAP then break end
						local t0 = os.clock()
						while not it[2] and os.clock() - t0 < 12 and my == listGen do task.wait(0.05) end
						if my ~= listGen or not list.Parent then return end
						addRow(it[1], it[2] or ("User " .. it[1]), it[3] or "", i)
					end
					if #items > CAP and my == listGen and list.Parent then
						new("TextLabel", { Size = UDim2.new(1, -6, 0, 24), BackgroundTransparency = 1, Text = "+ " .. (#items - CAP) .. " more",
							Font = T.font, TextSize = 12, TextColor3 = T.mut, LayoutOrder = CAP + 1, Parent = list })
					end
				end)
			end
			for kind, b in pairs(tabs) do b.Activated:Connect(function() load(kind) end) end
			load(startKind or "followers")
			if T.anim ~= false then
				tween(panel, 0.22, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })
			else
				panel.GroupTransparency, panel.Position = 0, UDim2.fromScale(0.5, 0.5)
			end
		end
		local statsBtn = new("TextButton", { Position = UDim2.fromOffset(190, 64), Size = UDim2.fromOffset(92, 20), BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.88, Text = "Stats  ›", Font = T.fontB, TextSize = 11, TextColor3 = T.text, AutoButtonColor = false,
			ZIndex = 5, Parent = card }, { corner(10) })
		statsBtn.Activated:Connect(function() openLists("followers") end)
		new("TextButton", { Position = folLbl.Position, Size = folLbl.Size, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			ZIndex = 5, Parent = card }).Activated:Connect(function() openLists("followers") end)
		new("TextButton", { Position = ingLbl.Position, Size = ingLbl.Size, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
			ZIndex = 5, Parent = card }).Activated:Connect(function() openLists("following") end)

		local done = false
		local function paint()
			if P.root ~= root then return end
			local c = FS.cache[id]
			local cnt = c and c.c
			local tier = tierOf(cnt or 0)
			badge.Text = cnt and ("TIER " .. ROMAN[tier]) or "TIER …"
			badge.BackgroundColor3 = TCOL[tier]
			folLbl.Text = string.format('<font size="20"><b>%s</b></font>\n<font size="11" color="rgb(150,156,175)">FOLLOWERS</font>',
				cnt and tostring(cnt) or (done and "—" or "…"))
			local fc = (id == ME) and FS.countFollowing(ME) or (FS.fcache[id] and FS.fcache[id].c)
			ingLbl.Text = string.format('<font size="20"><b>%s</b></font>\n<font size="11" color="rgb(150,156,175)">FOLLOWING</font>',
				fc and tostring(fc) or (done and "—" or "…"))
			local lo, nextAt = CONFIG.TIER_AT[tier], CONFIG.TIER_AT[tier + 1]
			if cnt and nextAt then
				nextLbl.Text = (nextAt - cnt) .. " more followers for Tier " .. ROMAN[tier + 1]
				tween(fill, 0.35, { Size = UDim2.fromScale(math.clamp((cnt - lo) / math.max(1, nextAt - lo), 0, 1), 1) })
			elseif cnt then
				nextLbl.Text = "Max tier reached"
				tween(fill, 0.35, { Size = UDim2.fromScale(1, 1) })
			else
				nextLbl.Text = ""
			end
			if followBtn then
				local following = FS.following[id] ~= nil
				followBtn.Text = following and "Unfollow" or "Follow"
				if following then
					tween(followBtn, 0.2, { BackgroundColor3 = WHITE, BackgroundTransparency = 0.86 })
					followBtn.TextColor3 = T.text
				else
					tween(followBtn, 0.2, { BackgroundColor3 = T.accA, BackgroundTransparency = 0 })
					followBtn.TextColor3 = WHITE
				end
			end
			if user == "" then
				local _, un2 = nameOf(id)
				if un2 and un2 ~= "" then user = un2; userLbl.Text = "@" .. un2 end
			end
		end

		local pending = false
		if followBtn then
			followBtn.Activated:Connect(function()
				if isMe then
					statusLbl.Text = "can't follow yourself lol"
					return
				end
				if pending then return end
				pending = true
				followBtn.Text = "…"
				statusLbl.Text = ""
				task.spawn(function()
					if not FS.loadedF then FS.loadMine() end
					local ok, why
					if FS.following[id] then ok, why = FS.unfollow(id) else ok, why = FS.follow(id, name, user) end
					pending = false
					if FS.threadId == id and FS.paintThread then FS.paintThread() end
					FS.render()
					if P.root == root then
						paint()
						if not ok then statusLbl.Text = "Couldn't update follow: " .. tostring(why) end
						if not ok then print("[SaikiChat] follow failed: " .. tostring(why)) end
					end
				end)
			end)
		end

		paint()
		if T.anim ~= false then
			tween(card, 0.22, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })
		else
			card.GroupTransparency, card.Position = 0, UDim2.fromScale(0.5, 0.5)
		end
		task.spawn(function()
			if not FS.loadedF and not FS.loading then FS.loadMine() end
			FS.count(id, true)
			if id ~= ME then FS.countFollowing(id, true) end
			done = true
			paint()
		end)
	end

end)()

