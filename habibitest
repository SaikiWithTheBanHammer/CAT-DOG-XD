local function hasFileSystem()
    return type(isfile) == "function"
        and type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfolder) == "function"
        and type(makefolder) == "function"
end

local function audioPath(videoId)
    return AUDIO_FOLDER .. "/" .. videoId .. ".mp3"
end

local function isCached(videoId)
    if not hasFileSystem() then
        return false
    end

    local ok, exists = pcall(isfile, audioPath(videoId))

    return ok and exists == true
end

local function assetFor(path)
    if getcustomasset then
        return getcustomasset(path)
    end

    if getsynasset then
        return getsynasset(path)
    end

    return "rbxasset://" .. path
end

local function refreshSavedTag(videoId)
