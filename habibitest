----------------------------------------------------------------- persistent cache + stickers
local function ensureFolder(path)
	if not makefolder then return end
	local cur = ""
	for part in string.gmatch(path, "[^/]+") do
		cur = (cur == "") and part or (cur .. "/" .. part)
		if not (isfolder and isfolder(cur)) then pcall(makefolder, cur) end
	end
end
ensureFolder(CACHE); ensureFolder(STICKER_CACHE)

local function cachedAsset(url, path)
	if not (writefile and isfile and getcustomasset) then return nil end
	if not isfile(path) then
		local ok, data = pcall(function()
			local r = REQUEST({ Url = url, Method = "GET" })
			local c = r and tonumber(r.StatusCode or r.Status or 0) or 0
			if c >= 200 and c < 300 then return r.Body or r.body end
		end)
		if ok and type(data) == "string" and #data > 0 then pcall(writefile, path, data) end
	end
	if isfile(path) then
		local ok, asset = pcall(getcustomasset, path)
		if ok then return asset end
	end
	return nil
end

-- limit simultaneous downloads (lag protection)
local dlActive = 0
local function limited(fn)
	while alive and dlActive >= 3 do task.wait(0.05) end
	dlActive += 1
	local ok, res = pcall(fn)
	dlActive -= 1
	return ok and res or nil
end

local repoSet = {}
for _, r in ipairs(STICKER_REPOS) do repoSet[r.repo] = true end
local function isImageName(n)
	n = n:lower()
	return n:match("%.png$") or n:match("%.jpg$") or n:match("%.jpeg$") or n:match("%.webp$") or n:match("%.gif$")
end
-- a sticker reference is "Repo/file.png"; only our own repos are accepted
local function validSticker(s)
	if type(s) ~= "string" or #s > 100 then return nil end
	local repo, name = s:match("^([^/]+)/([^/\\]+)$")
	if repo and repoSet[repo] and isImageName(name) and not name:find("%c") then return s end
	return nil
end
local function stickerAsset(ref)
	local repo, name = ref:match("^([^/]+)/(.+)$")
	if not repo then return nil end
	local url = "https://raw.githubusercontent.com/" .. GITHUB_OWNER .. "/" .. repo .. "/main/" .. enc(name)
	local path = STICKER_CACHE .. "/" .. safeName(repo) .. "_" .. safeName(name)
	return limited(function() return cachedAsset(url, path) end)
end

local listingMem = {}
local function getListing(repo)
	if listingMem[repo] then return listingMem[repo] end
	local lp = STICKER_CACHE .. "/" .. safeName(repo) .. "_list.json"
	local disk
	pcall(function()
		if isfile and readfile and isfile(lp) then
			local d = HttpService:JSONDecode(readfile(lp))
			if type(d) == "table" and type(d.names) == "table" then disk = d end
		end
	end)
	if disk and (os.time() - (disk.t or 0)) < CONFIG.STICKER_LIST_TTL then
		listingMem[repo] = disk.names
		return disk.names
	end
	local ok, data = requestJSON("GET", "https://api.github.com/repos/" .. GITHUB_OWNER .. "/" .. repo .. "/contents",
		nil, { Accept = "application/vnd.github+json" })
	if ok and type(data) == "table" then
		local names = {}
		for _, it in ipairs(data) do
			if it.type == "file" and isImageName(it.name) then names[#names + 1] = it.name end
		end
		table.sort(names)
		pcall(function() if writefile then writefile(lp, HttpService:JSONEncode({ t = os.time(), names = names })) end end)
		listingMem[repo] = names
		return names
	end
	if disk then listingMem[repo] = disk.names; return disk.names end -- offline: use stale list
	return nil
end

----------------------------------------------------------------- security: bans + identity guard
local KICK_SPOOF = "Saiki Chat does not Permit Spoofing"
local KICK_BAN = "You are banned from Saiki Chat."
local banned, bannedHwid = {}, {}
for id, v in pairs(BANNED_USER_IDS) do banned[id] = v end

local function kick(msg) pcall(function() LP:Kick(msg) end) end

-- hashed hardware id, computed locally and only compared with the ban list (never sent anywhere)
local function myHwidHash()
	local fn = gethwid or getmacaddress or getdeviceid
	if not fn then return nil end
	local ok, raw = pcall(fn)
	if not ok or type(raw) ~= "string" or raw == "" then return nil end
	raw = raw:lower():gsub("%s+", "")
	local hasher = crypt and crypt.hash
	if hasher then
		local ok2, res = pcall(hasher, raw, "sha256")
		if ok2 and type(res) == "string" then return res:lower() end
	end
	return nil
end
local MY_HWID = myHwidHash()

local function loadBanList()
	if CONFIG.BAN_LIST_URL == "" then return end
	local ok, data = requestJSON("GET", CONFIG.BAN_LIST_URL)
	if ok and type(data) == "table" then
		if type(data.ids) == "table" then
			for _, id in ipairs(data.ids) do banned[tonumber(id) or id] = true end
		end
		if type(data.hwids) == "table" then
			for _, h in ipairs(data.hwids) do bannedHwid[tostring(h):lower()] = true end
		end
	end
end
local function isBanned() return banned[LP.UserId] or (MY_HWID and bannedHwid[MY_HWID]) or false end

-- baseline of the 4 credentials taken at launch
local base = { name = LP.Name, id = LP.UserId, dn = LP.DisplayName, age = LP.AccountAge }

-- check 1: did any of the 4 values change locally since launch?
local function localDrift()
	return LP.Name ~= base.name or LP.UserId ~= base.id or LP.DisplayName ~= base.dn or LP.AccountAge ~= base.age
end

-- extra anchors: Roblox's own player lookups don't use the properties a spoofer edits
local function anchorsOk()
	local ok1, p = pcall(function() return Players:GetPlayerByUserId(LP.UserId) end)
	if not ok1 or p ~= LP then return false end
	local ok2, q = pcall(function() return Players:FindFirstChild(LP.Name) end)
	if ok2 and q ~= LP then return false end
	return true
end

-- check 2: compare all 4 with Roblox's API. true = matches, false = mismatch, nil = couldn't check
local function apiCheck(withDisplay)
	local ok, d = requestJSON("GET", "https://users.roblox.com/v1/users/" .. tostring(LP.UserId))
	if not ok or type(d) ~= "table" or not d.id then return nil end
	if tonumber(d.id) ~= LP.UserId then return false end
	if tostring(d.name):lower() ~= LP.Name:lower() then return false end
	if withDisplay and tostring(d.displayName) ~= LP.DisplayName then return false end
	local okT, dt = pcall(DateTime.fromIsoDate, tostring(d.created))
	if okT and dt then
		local days = math.floor((os.time() - dt.UnixTimestamp) / 86400)
		if math.abs(days - LP.AccountAge) > CONFIG.AGE_TOLERANCE_DAYS then return false end
	end
	return true
end

-- returns "ok" | "spoof" (definite) | "mismatch" (API disagrees, needs 2 strikes) | "unknown"
local function checkIdentity(withDisplay)
	if localDrift() or not anchorsOk() then return "spoof" end
	if not REQUEST then return "unknown" end
	local r = apiCheck(withDisplay)
	if r == nil then return "unknown" end
	return r and "ok" or "mismatch"
end

-- startup gate: nothing is built if this fails
loadBanList()
if isBanned() then kick(KICK_BAN); do return end end
do
	local strikes, verdict = 0, "unknown"
	for _ = 1, 4 do
		verdict = checkIdentity(true) -- full 4-field API comparison at launch
		if verdict == "spoof" then kick(KICK_SPOOF); do return end end
		if verdict == "mismatch" then
			strikes += 1
			if strikes >= 2 then kick(KICK_SPOOF); do return end end
		elseif verdict == "ok" then
			break
		end
		task.wait(2)
	end
	if verdict ~= "ok" then
		warn("[SAIKI RECHAT] Roblox API identity check unavailable; continuing without it.")
		if CONFIG.REQUIRE_API then return end
	end
end

