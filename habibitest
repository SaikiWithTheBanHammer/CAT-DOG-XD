	for i = 1, 8 do
		rods[i] = part("Spoke", Vector3.new(0.45 * SCALE, ROD_LENGTH * SCALE, 0.45 * SCALE))
		balls[i] = part("Ball", Vector3.new(BALL_SIZE * SCALE, BALL_SIZE * SCALE, BALL_SIZE * SCALE), Enum.PartType.Ball)
	end
	local spin = 0
	return {
		update = function(char, dt, t)
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			spin = spin + dt * 0.6
			local radius = RADIUS * SCALE
			local pos = root.Position - root.CFrame.LookVector * DISTANCE + root.CFrame.UpVector * HEIGHT
			local cf = CFrame.lookAt(pos, pos + root.CFrame.LookVector) * CFrame.Angles(math.rad(ANGLEX), 0, 0)
			center.CFrame = cf
			for i, v in ipairs(ring) do
				local a = (math.pi * 2 / SEGMENTS) * i
				v.CFrame = cf * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0) * CFrame.Angles(0, 0, a)
			end
			for i = 1, 8 do
				local a = (math.pi * 2 / 8) * i + spin
				rods[i].CFrame = cf * CFrame.Angles(0, 0, a)
				balls[i].CFrame = cf * CFrame.new(math.cos(a) * radius * 1.45, math.sin(a) * radius * 1.45, 0)
			end
		end,
		destroy = function() end,
	}
end

