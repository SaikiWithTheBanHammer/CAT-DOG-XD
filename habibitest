--========================================================
-- SEARCH AND PAGINATION
--========================================================

local busy = false
local currentQuery = ""
local currentPage = 1
local nextToken = nil
local previousTokens = {}
local hasNext = false
local hasPrevious = false

local function updatePagination()
    pageLabel.Text = "Page " .. currentPage

    previousButton.Active = hasPrevious and not busy
    previousButton.AutoButtonColor = previousButton.Active
    previousButton.TextTransparency = previousButton.Active and 0 or 0.5

    nextButton.Active = hasNext and not busy
    nextButton.AutoButtonColor = nextButton.Active
    nextButton.TextTransparency = nextButton.Active and 0 or 0.5
end

local function loadPage(token, direction)
    if busy then return end

    if direction == "next" and not hasNext then return end
    if direction == "previous" and not hasPrevious then return end

    busy = true
    searchButton.Text = "..."
    nextButton.Text = "Loading..."
    status.Text = "Searching and checking video durations..."
    clearResults()
    updatePagination()

    task.spawn(function()
        local ok, err = pcall(function()
            local url = "https://www.googleapis.com/youtube/v3/search"
                .. "?part=snippet"
                .. "&type=video"
                .. "&maxResults=10"
                .. "&q=" .. urlEncode(currentQuery)
                .. "&key=" .. urlEncode(API_KEY)

            if token and token ~= "" then
                url = url .. "&pageToken=" .. urlEncode(token)
            end

            -- Search page
            local data = apiGet(url)

            -- Remember page tokens for Previous/Next navigation
            if direction == "new" then
                currentPage = 1
                previousTokens = {}
            elseif direction == "next" then
                table.insert(previousTokens, token)
                currentPage += 1
            elseif direction == "previous" then
                currentPage = math.max(1, currentPage - 1)
            end

            nextToken = data.nextPageToken
            hasNext = nextToken ~= nil
            hasPrevious = currentPage > 1

            local items = data.items or {}
            local ids = {}

            for _, item in ipairs(items) do
                if item.id and item.id.videoId then
                    table.insert(ids, item.id.videoId)
                end
            end

            if #ids == 0 then
                status.Text = "No videos found on this page."
                return
            end

            -- Batch-fetch duration details for all 10 videos
            local detailsUrl = "https://www.googleapis.com/youtube/v3/videos"
                .. "?part=contentDetails"
                .. "&id=" .. urlEncode(table.concat(ids, ","))
                .. "&key=" .. urlEncode(API_KEY)

            local details = apiGet(detailsUrl)
            local durationMap = {}

            for _, video in ipairs(details.items or {}) do
                local iso = video.contentDetails
                    and video.contentDetails.duration

                if iso then
                    durationMap[video.id] = {
                        iso = iso,
                        seconds = durationSeconds(iso),
                        formatted = formatDuration(iso)
                    }
                end
            end

            local shown = 0
            local skipped = 0

            for _, item in ipairs(items) do
                local videoId = item.id and item.id.videoId
                local info = videoId and durationMap[videoId]

                if info then
                    -- Shorts filtering:
                    -- YouTube API does not expose a definitive Shorts flag.
                    -- Exclude videos under 60 seconds as a practical filter.
                    if info.seconds < 60 then
                        skipped += 1
                    else
                        shown += 1
                        createResult(shown, item, info.formatted)
                    end
                end
            end

            if shown == 0 then
                status.Text = "No eligible videos on this page. Try Next 10."
            else
                status.Text = string.format(
                    "Showing %d videos%s",
                    shown,
                    skipped > 0 and (" | Skipped " .. skipped .. " short videos") or ""
                )
            end
        end)

        busy = false
        searchButton.Text = "SEARCH"
        nextButton.Text = "Next 10 >"
        previousButton.Text = "< Previous 10"

        updatePagination()

        if not ok then
            status.Text = "Error: " .. tostring(err)
        end
    end)
end

searchButton.MouseButton1Click:Connect(function()
    local query = searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

    if query == "" then
        status.Text = "Please enter a search term."
        return
    end

    currentQuery = query
    currentPage = 1
    nextToken = nil
    previousTokens = {}
    hasPrevious = false
    hasNext = false

    loadPage(nil, "new")
end)

searchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        searchButton:Activate()
    end
end)

nextButton.MouseButton1Click:Connect(function()
    if busy or not hasNext or not nextToken then return end
    loadPage(nextToken, "next")
end)

previousButton.MouseButton1Click:Connect(function()
    if busy or not hasPrevious then return end

    -- Search API uses opaque tokens. Store the token used to
    -- reach each page, and use the previous page's token.
    local tokenForPrevious = previousTokens[#previousTokens]

    if tokenForPrevious then
        table.remove(previousTokens)
        loadPage(tokenForPrevious, "previous")
    end
end)

updatePagination()

--========================================================
-- DRAG WINDOW
--========================================================

local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

