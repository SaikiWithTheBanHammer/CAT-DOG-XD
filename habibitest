	-- ===== announcements (!anc): everyone checks the sender's tier themselves before drawing a banner =====
	-- tier of a user: from the cached follower count, or (wait = true) looked up now. nil = couldn't tell.
	function T.annTier(uid, wait)
		local id = string.format("%.0f", tonumber(uid) or 0)
		local c = FS.cache[id]
		if c and os.clock() - c.t < 120 then return FS.tierOf(c.c) end
		if not wait then return nil end
		local n = FS.count(id, true)
		return n and FS.tierOf(n) or nil
	end
	function T.tierColor(uid) -- colour of the user's tier (II and up), nil if unknown / Tier I
		local t = T.annTier(uid, false)
		return (t and t >= 2) and FS.TCOL[t] or nil
	end
	-- called when "!anc ..." is typed in a chat box; true = handled (sent), false = kept in the box
	function T.annSend(view, txt)
		if not view.allowAnc then view.notice("!anc only works in the Saiki Server chat."); return false end
		local body = txt:match("^%S+%s+(.+)$")
		if not body then view.notice("Usage: !anc your announcement"); return false end
		local min = CONFIG.ANNOUNCE_MIN_TIER or 4
		local tier = T.annTier(ME, true)
		if not tier then view.notice("Couldn't check your tier right now, try again in a moment."); return false end
		if tier < min then
			local t = CONFIG.TITLES and CONFIG.TITLES[min] or ""
			view.notice("Announcements unlock at Tier " .. tostring(FS.ROMAN[min] or min) .. ((t ~= "") and (" (" .. t .. ")") or "") .. ".")
			return false
		end
		local left = (T.annLast or -1e9) + (CONFIG.ANNOUNCE_COOLDOWN or 20) - os.clock()
		if left > 0 then view.notice("Announcement cooldown: " .. math.ceil(left) .. "s"); return false end
		if view.sendText("!anc " .. body) then T.annLast = os.clock(); return true end
		return false
	end

