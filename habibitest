local function startJob(videoId, key)
    local watchURL = "https://www.youtube.com/watch?v=" .. videoId

    local url = "https://p.savenow.to/ajax/download.php?url="
        .. encodeURL(watchURL)
        .. "&format=mp3&apikey=" .. encodeURL(key)
        .. "&add_info=1&allow_extended_duration=1&no_merge=0"

    local body = safeGet(url)

    if not body then
        return nil, "No response"
    end

    local data = decodeJson(body)

    if not data then
        return nil, "Bad JSON"
    end

    if data.id then
        return data.id, nil
    end

    return nil, tostring(data.error or data.message or "Job failed")
end

local function waitForJob(jobId, generation, onProgress)
    local deadline = tick() + 300

    while tick() < deadline do
        if generation ~= player.generation then
            return nil, "Cancelled"
        end

        local body = safeGet(
            "https://p.savenow.to/ajax/progress.php?id=" .. encodeURL(jobId)
        )

        local data = body and decodeJson(body)

        if data then
            local raw = tonumber(data.progress) or 0
            local percent

            if raw > 100 then
                percent = math.floor(raw / 10)
            else
                percent = math.floor(raw)
            end

            percent = math.clamp(percent, 0, 100)
            onProgress(percent)

            if raw >= 1000 and data.download_url then
                return data.download_url, data
            end

            if data.error and data.error ~= "" then
                return nil, tostring(data.error)
            end
        end

        task.wait(1.5)
    end

    return nil, "Timeout"
end

local function ensureAudio(videoId, generation, onProgress)
    if not isfolder(AUDIO_FOLDER) then
        makefolder(AUDIO_FOLDER)
    end

    local path = audioPath(videoId)

    if isfile(path) then
        local okRead, content = pcall(readfile, path)

        if okRead and type(content) == "string" and #content >= MIN_AUDIO_BYTES then
            return path, nil
        end
    end

    local jobId
    local lastError = "No response"

    for attempt = 0, #DOWNLOAD_KEYS - 1 do
        if generation ~= player.generation then
            return nil, "Cancelled"
        end

        local keyIndex = (player.activeKey - 1 + attempt) % #DOWNLOAD_KEYS + 1
        local startedId, startError = startJob(videoId, DOWNLOAD_KEYS[keyIndex])

        if startedId then
            jobId = startedId
            player.activeKey = keyIndex
            break
        end

        lastError = startError or lastError
        task.wait(0.5)
    end

    if not jobId then
        return nil, lastError
    end

    local downloadURL, info = waitForJob(jobId, generation, onProgress)

    if not downloadURL then
        return nil, tostring(info)
    end

    local body = safeGet(downloadURL)

    if not body or #body < MIN_AUDIO_BYTES then
        return nil, "Download failed"
    end

    writefile(path, body)

    return path, nil
end

local function lookupTitle(videoId)
    local fallback = "YouTube audio " .. videoId

    local ok, data = pcall(
        httpGet,
        "https://www.googleapis.com/youtube/v3/videos?part=snippet&id="
            .. encodeURL(videoId)
            .. "&key=" .. encodeURL(API_KEY)
    )

    if ok
        and type(data) == "table"
        and data.items
        and data.items[1]
        and data.items[1].snippet then
        return data.items[1].snippet.title or fallback
    end

    return fallback
end

local function playVideo(video)
    if not hasFileSystem() then
        setStatus(
            "Your executor is missing file functions (isfile / readfile / writefile).",
            ORANGE
        )
        return
    end

    player.generation += 1
    local generation = player.generation

    destroySound()
    resetPlayerUI(video.title or video.id)
    progressFill.BackgroundColor3 = ORANGE

    task.spawn(function()
        local videoTitle = video.title

        if not videoTitle then
            setStatus("Looking up video...", LIGHT)
            videoTitle = lookupTitle(video.id)

            if generation ~= player.generation then
                return
            end

            nowTitle.Text = videoTitle
        end

        local wasCached = isCached(video.id)

        if wasCached then
            setStatus("Found saved audio. Loading...", GREEN)
        else
            setStatus("Downloading audio...", LIGHT)
        end

        local function onProgress(percent)
            if generation ~= player.generation then
                return
            end

            progressFill.Size = UDim2.new(percent / 100, 0, 1, 0)
            timeLabel.Text = "Downloading " .. tostring(percent) .. "%"
            setStatus("Downloading audio... " .. tostring(percent) .. "%", LIGHT)
        end

        local ok, path, failure = pcall(ensureAudio, video.id, generation, onProgress)

        if not ok then
            failure = path
            path = nil
        end

        if generation ~= player.generation then
            return
        end

        if not path then
            resetPlayerUI()
            setStatus("Audio error: " .. tostring(failure), RED)
            return
        end

        local sound = Instance.new("Sound")
        sound.Name = SOUND_NAME
        sound.Volume = 1
        sound.Looped = player.looping

        local okAsset, asset = pcall(assetFor, path)

        if not okAsset then
            sound:Destroy()
            resetPlayerUI()
            setStatus("Could not load the file: " .. tostring(asset), RED)
            return
        end

        sound.SoundId = asset
        sound.Parent = SoundService
        player.sound = sound

        local waited = 0

        while not sound.IsLoaded and waited < 10 do
            task.wait(0.1)
            waited += 0.1

            if generation ~= player.generation then
                sound:Destroy()
                return
            end
        end

        if not sound.IsLoaded then
            sound:Destroy()

            if player.sound == sound then
                player.sound = nil
            end

            if delfile then
                pcall(delfile, path)
            end

            resetPlayerUI()
            setStatus("Audio failed to load. The saved copy was removed, try again.", RED)
            return
        end

        progressFill.BackgroundColor3 = GREEN
        nowTitle.Text = videoTitle

        sound.Ended:Connect(function()
            if player.sound == sound then
                pauseButton.Text = "PLAY"
                setStatus("Finished: " .. videoTitle, LIGHT)
            end
        end)

        sound:Play()
        refreshSavedTag(video.id)

        if wasCached then
            setStatus("Playing saved copy: " .. videoTitle, GREEN)
        else
            setStatus("Downloaded and playing: " .. videoTitle, GREEN)
        end
    end)
end

