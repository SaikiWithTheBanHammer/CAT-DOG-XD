local function renderSearchResults(query, pageToken)
    currentQuery = query
    scrollList:ClearAllChildren()
    listLayout.Parent = scrollList
    
    statusText.Text = "Status: Searching YouTube..."
    local searchUrl = "https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&maxResults=10&q=" .. urlEncode(query) .. "&key=" .. YOUTUBE_API_KEY
    if pageToken then
        searchUrl = searchUrl .. "&pageToken=" .. pageToken
    end
    
    local success, res = pcall(function()
        return req({Url = searchUrl, Method = "GET"})
    end)
    
    if not success or not res or not res.Body then
        statusText.Text = "Status: Network request failed"
        print("[Debug Error] Request failed completely.")
        return
    end
    
    -- Print response code for debugging (200 means success, 400/403 means bad key or quota)
    print("[Debug] API Response Code:", res.StatusCode)
    print("[Debug] API Body:", res.Body)
    
    local sData = HttpService:JSONDecode(res.Body)
    if sData.error then
        statusText.Text = "Status: API Error (" .. tostring(sData.error.code) .. ")"
        warn("[YouTube API Error]: " .. tostring(sData.error.message))
        return
    end
    
    if not sData or not sData.items or #sData.items == 0 then
        statusText.Text = "Status: No results found"
        return
    end
    
    nextPageToken = sData.nextPageToken
    statusText.Text = "Status: Ready"
end
