		statusLbl = label({ Position = UDim2.fromOffset(16, 170), Size = UDim2.new(1, -32, 0, 34), Text = "Pick an option below.", Font = T.fontB, TextSize = 12, TextColor3 = T.mut })
		local function btn(text, x, y, w, accent, fn)
			local b = new("TextButton", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 34), BackgroundColor3 = accent or WHITE,
				BackgroundTransparency = accent and 0.72 or 0.9, Text = text, Font = T.fontB, TextSize = 12, TextColor3 = T.text,
