local UserInputService = game:GetService("UserInputService")

local old = CoreGui:FindFirstChild(GUI_NAME)
if old then old:Destroy() end

local requestFunc = request or http_request
    or (syn and syn.request)
    or (fluxus and fluxus.request)

local clipboardFunc = setclipboard or toclipboard
    or (Clipboard and Clipboard.set)

if not requestFunc then
    warn("Saiki YouTube: HTTP requests unsupported.")
    return
end

local function get(url)
    local response = requestFunc({
        Url = url,
        Method = "GET",
        Headers = {Accept = "application/json"}
    })

    local statusCode = tonumber(
        response.StatusCode or response.Status
    ) or 0

    local ok, data = pcall(function()
        return HttpService:JSONDecode(response.Body or "")
    end)

    if not ok then
        error("Invalid JSON response from YouTube.")
    end

    if statusCode < 200 or statusCode >= 300 then
        error(data.error and data.error.message
            or ("YouTube API HTTP " .. statusCode))
    end

    return data
end

local function encode(s)
    return (s:gsub("([^%w%-_%.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

-- Robust ISO 8601 duration parser:
-- PT5M20S -> 5:20; PT1H2M3S -> 1:02:03
local function parseDuration(s)
    if type(s) ~= "string" then return nil end

    local d, h, m, sec = s:match(
        "^P(?:(%d+)D)?T?(?:(%d+)H)?(?:(%d+)M)?(?:(%d+)S)?$"
    )

    -- Also support ordinary YouTube durations beginning with PT.
    if not d and not h and not m and not sec then
        d = s:match("(%d+)D")
        h = s:match("(%d+)H")
        m = s:match("(%d+)M")
        sec = s:match("(%d+)S")
    end

    local total = (tonumber(d) or 0) * 86400
        + (tonumber(h) or 0) * 3600
        + (tonumber(m) or 0) * 60
        + (tonumber(sec) or 0)

    if not s:match("^P") then return nil end

    local formatted
    if total >= 3600 then
        formatted = string.format(
            "%d:%02d:%02d",
            math.floor(total / 3600),
            math.floor(total % 3600 / 60),
            total % 60
        )
    else
        formatted = string.format(
            "%d:%02d",
            math.floor(total / 60),
            total % 60
        )
    end

    return formatted, total
end

