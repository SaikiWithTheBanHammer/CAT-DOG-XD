do
	local holder = new("Frame", { Name = "SaikiNotifs", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(300, 260), BackgroundTransparency = 1, ZIndex = 100, Parent = gui }, {
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 6) }),
	})
	local active, seq = {}, 0
	local function kill(n)
		if n.dead then return end
		n.dead = true
		for i, x in ipairs(active) do if x == n then table.remove(active, i); break end end
		if T.anim ~= false and n.card.Parent then
			tween(n.card, 0.2, { GroupTransparency = 1 })
			task.delay(0.22, function() n.card:Destroy() end)
		else
			n.card:Destroy()
		end
	end
	function T.clearNotifs()
		for i = #active, 1, -1 do kill(active[i]) end
	end
	-- key: same key = refresh the card that is already showing (no spam); head/body: the two text lines
	function T.notify(key, head, body)
		if not alive or T.notif == false then return end
		for _, n in ipairs(active) do
			if n.key == key then
				n.head.Text, n.body.Text, n.t = head, tostring(body or ""), os.clock()
				return
			end
		end
		while #active >= 4 do kill(active[1]) end
		seq = seq + 1
		local card = new("CanvasGroup", { Size = UDim2.fromOffset(300, 56), BackgroundColor3 = T.bg, BackgroundTransparency = 0.06,
			GroupTransparency = (T.anim ~= false) and 1 or 0, LayoutOrder = seq, ZIndex = 100, Parent = holder }, { corner(14), stroke(0.8) })
		local n = { key = key, card = card, t = os.clock() }
		n.head = new("TextLabel", { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -48, 0, 16), BackgroundTransparency = 1,
			Text = head, Font = T.fontB, TextSize = 12, TextColor3 = T.accB, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 101, Parent = card })
		n.body = new("TextLabel", { Position = UDim2.fromOffset(14, 27), Size = UDim2.new(1, -48, 0, 20), BackgroundTransparency = 1,
			Text = tostring(body or ""), Font = T.font, TextSize = 13, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 101, Parent = card })
		local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(22, 22),
			BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, Text = "×", Font = T.fontB, TextSize = 16, TextColor3 = T.text,
			AutoButtonColor = false, ZIndex = 102, Parent = card }, { corner(11) })
		x.Activated:Connect(function() kill(n) end)
		active[#active + 1] = n
		if T.anim ~= false then tween(card, 0.25, { GroupTransparency = 0 }) end
		task.spawn(function() -- gone by itself after 3 seconds
			while alive and not n.dead do
				task.wait(0.25)
				if os.clock() - n.t >= 3 then kill(n) end
			end
		end)
	end
end

