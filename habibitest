----------------------------------------------------------------- follower system (Firebase project sxikiflowsys)
do
	local ROMAN = { "I", "II", "III", "IV", "V" }
	local TCOL = { Color3.fromRGB(120, 132, 165), Color3.fromRGB(80, 205, 140), Color3.fromRGB(64, 165, 255),
		Color3.fromRGB(160, 105, 255), Color3.fromRGB(255, 192, 64) }
	local function tierOf(n)
		local t = 1
		for i, th in ipairs(CONFIG.TIER_AT) do if n >= th then t = i end end
		return t
	end
	FS.tierOf, FS.ROMAN, FS.TCOL = tierOf, ROMAN, TCOL
	FS.following, FS.followers, FS.cache = {}, {}, {} -- following[targetId]={n,u}; followers=list; cache[id]={c,t}
	FS.stamp, FS.loadedF, FS.loading, FS.ok, FS.locked = -1e9, false, false, false, false
	FS.fcache, FS.profileOK, FS.mirrored = {}, false, false -- fcache[id]={c,t} = how many people `id` follows
	-- readable reason for a failed Firebase call (includes Firebase's own message)
	local function whyFail(code, raw, step)
		local m = type(raw) == "string" and raw:match('"error"%s*:%s*"([^"]+)"') or nil
		if code == 401 or code == 403 then
			return "refused by the follower rules at '" .. step .. "' (" .. (m or "Permission denied") .. "). Publish the new rules in sxikiflowsys"
		end
		return "HTTP " .. tostring(code) .. " at '" .. step .. "'" .. (m and (" (" .. m .. ")") or "")
	end
	local function fsReq(method, path, body, extra) return dbRequest(method, path, body, fsAuth, FS_FIREBASE_DB, extra) end
	FS.req = fsReq
	local function myUid()
		if ensureToken(fsAuth) then return fsAuth.uid end
		return nil
	end
	local function idStr(n) return string.format("%.0f", tonumber(n) or 0) end

	-- followers of `id` = number of keys under /followers/<id> (shallow = keys only, tiny download)
	function FS.count(id, force)
		local c = FS.cache[id]
		if c and not force and os.clock() - c.t < 60 then return c.c end
		local ok, data = fsReq("GET", "/followers/" .. id, nil, "shallow=true")
		if not ok then return c and c.c or nil end
		local n = 0
		if type(data) == "table" then for _ in pairs(data) do n = n + 1 end end
		FS.cache[id] = { c = n, t = os.clock() }
		return n
	end

	-- how many people `id` follows (own list is known locally, others come from the /following index)
	function FS.countFollowing(id, force)
		if id == ME and FS.loadedF then
			local n = 0
			for _ in pairs(FS.following) do n += 1 end
			return n
		end
		local c = FS.fcache[id]
		if c and not force and os.clock() - c.t < 60 then return c.c end
		local ok, data = fsReq("GET", "/following/" .. id, nil, "shallow=true")
		if not ok then return c and c.c or nil end
		local n = 0
		if type(data) == "table" then for _ in pairs(data) do n += 1 end end
		FS.fcache[id] = { c = n, t = os.clock() }
		return n
	end

	function FS.writeProfile()
		local uid = myUid()
		if not uid then return end
		local ok, _, raw, code = fsReq("PUT", "/profiles/" .. ME, { robloxUserId = LP.UserId, username = cut(LP.Name, 40),
			displayName = cut(LP.DisplayName, 80), firebaseUid = uid, updatedAt = SV })
		FS.locked = (not ok) and (code == 401 or code == 403)
		FS.profileOK = ok and true or false
		if not ok then warn("[SAIKI RECHAT] profile not saved: " .. whyFail(code, raw, "profiles")) end
	end

	function FS.follow(id, name, user)
		local uid = myUid()
		if not uid then return false, "follower system offline (" .. tostring(fsAuth.err) .. ")" end
		if id == ME then return false, "can't follow yourself lol" end
		local ok, _, raw, code = fsReq("PUT", "/follows/" .. uid .. "/" .. id, { targetRobloxUserId = tonumber(id),
			targetUsername = cut(user or name or "", 40), targetDisplayName = cut(name or user or "", 80), createdAt = SV })
		if not ok then return false, whyFail(code, raw, "follows") end
		local ok2, _, raw2, code2 = fsReq("PUT", "/followers/" .. id .. "/" .. uid, { ts = SV, rid = LP.UserId,
			un = cut(LP.Name, 40), dn = cut(LP.DisplayName, 80) })
		if not ok2 then
			fsReq("DELETE", "/follows/" .. uid .. "/" .. id)
			return false, whyFail(code2, raw2, "followers")
		end
		if not FS.profileOK then FS.writeProfile() end
		if FS.profileOK then fsReq("PUT", "/following/" .. ME .. "/" .. id, { ts = SV }) end -- public counter index (best effort)
		FS.following[id] = { n = name or user or id, u = user or "" }
		local c = FS.cache[id]
		if c then c.c = c.c + 1 end
		return true
	end

	function FS.unfollow(id)
		local uid = myUid()
		if not uid then return false, "follower system offline" end
		local ok = fsReq("DELETE", "/follows/" .. uid .. "/" .. id)
		local ok2 = fsReq("DELETE", "/followers/" .. id .. "/" .. uid)
		fsReq("DELETE", "/following/" .. ME .. "/" .. id)
		if not ok or not ok2 then return false, "couldn't remove it, try again" end
		FS.following[id] = nil
		local c = FS.cache[id]
		if c and c.c > 0 then c.c = c.c - 1 end
		return true
	end

	function FS.loadMine()
		if FS.loading then return end
		local uid = myUid()
		if not uid then FS.render(); return end
		FS.loading = true
		local ok, data = fsReq("GET", "/follows/" .. uid)
		if ok then
			local f = {}
			if type(data) == "table" then
				for tid, r in pairs(data) do
					if type(r) == "table" then
						f[tostring(tid)] = { n = tostring(r.targetDisplayName or r.targetUsername or tid), u = tostring(r.targetUsername or "") }
					end
				end
			end
			FS.following, FS.loadedF = f, true
			if not FS.mirrored and FS.profileOK then -- one-time: make sure my follows are in the public /following counter index
				FS.mirrored = true
				task.spawn(function()
					local okm, have = fsReq("GET", "/following/" .. ME, nil, "shallow=true")
					if not okm then FS.mirrored = false; return end
					for tid in pairs(f) do
						if not (type(have) == "table" and have[tid]) then fsReq("PUT", "/following/" .. ME .. "/" .. tid, { ts = SV }) end
					end
				end)
			end
		end
		local ok2, d2 = fsReq("GET", "/followers/" .. ME)
		if ok2 then
			local list = {}
			if type(d2) == "table" then
				for _, r in pairs(d2) do
					if type(r) == "table" and tonumber(r.rid) then
						list[#list + 1] = { id = idStr(r.rid), n = tostring(r.dn or r.un or "?"), u = tostring(r.un or ""), ts = tonumber(r.ts) or 0 }
					end
				end
			end
			table.sort(list, function(a, b) return a.ts > b.ts end)
			FS.followers = list
			FS.cache[ME] = { c = #list, t = os.clock() }
		end
		FS.stamp, FS.loading = os.clock(), false
		FS.render()
		if FS.paintThread then FS.paintThread() end
	end

	function FS.init()
		if not REQUEST then FS.render(); return end
		if myUid() then
			FS.ok = true
			FS.writeProfile()
			FS.loadMine()
		else
			FS.render()
		end
	end

	-- ===== DM thread header: follower count, tier, Follow button =====
	function FS.paintThread()
		local id = FS.threadId
		if not id then return end
		local c = FS.cache[id]
		dmSub.Text = c and (c.c .. (c.c == 1 and " follower" or " followers") .. "  •  Tier " .. ROMAN[tierOf(c.c)]) or "…"
