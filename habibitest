function buildHome()
	local keep = feed.CanvasPosition
	clearList(feed)
	-- players in this server (history / friends / Saiki users first)
	local arr = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local id = tostring(p.UserId)
			arr[#arr + 1] = { id = id, name = p.DisplayName, user = p.Name, unread = isUnread(id), saiki = directory[id] ~= nil,
				rank = (index[id] and 4 or 0) + (friends[id] and 2 or 0) + (directory[id] and 1 or 0) }
		end
	end
	table.sort(arr, function(a, b)
		if a.rank ~= b.rank then return a.rank > b.rank end
		return a.name:lower() < b.name:lower()
	end)
	addHeader(feed, "In this server", 1, (#arr > 0) and (#arr .. " here  •  ● on Saiki") or nil)
	if #arr == 0 then addEmpty(feed, "No other players in this server.", 2, 34) else addStrip(feed, arr, 2) end
	-- recent conversations
	local rec = {}
	for pid, e in pairs(index) do if e.l then rec[#rec + 1] = { id = pid, e = e } end end
	table.sort(rec, function(a, b) return (a.e.ts or 0) > (b.e.ts or 0) end)
	addHeader(feed, "Recent", 3, (#rec > 0) and tostring(#rec) or nil)
	if #rec == 0 then
		addEmpty(feed, "No conversations yet.\nTap a player above or use search to start one.", 4, 64)
	else
		for i, it in ipairs(rec) do
			if i > 60 then break end
			local e = it.e
			makeRow(feed, { id = it.id, name = e.n or ("User " .. it.id), user = e.u, ts = e.ts,
				sub = (e.me and "You: " or "") .. (e.x or ""), unread = isUnread(it.id) }, 10 + i)
		end
	end
	feed.CanvasPosition = keep
end

