			return l
		end

		local function paint(r)
			local id = r.id
			local n = counts[id] or 0
			local tier = FS.tierOf(n)
			local ttl = CONFIG.TITLES and CONFIG.TITLES[tier] or ""
			if ttl ~= "" then
				if not r.title then r.title = pill(r.row, 2, ttl, FS.TCOL[tier], false) end
				r.title.Text, r.title.TextColor3, r.title.BackgroundColor3 = ttl, FS.TCOL[tier], FS.TCOL[tier]
			elseif r.title then
				r.title:Destroy(); r.title = nil
			end
			local rk = rankOf[id]
			if rk then
				local col = METAL[rk] or T.accB
				if not r.rank then r.rank = pill(r.row, 3, "", col, true) end
				r.rank.Text, r.rank.TextColor3, r.rank.BackgroundColor3 = "#top" .. rk, col, col
			elseif r.rank then
				r.rank:Destroy(); r.rank = nil
			end
		end

		local function repaintAll()
			local keep = {}
			for _, r in ipairs(reg) do
				if r.row and r.row.Parent then
					pcall(paint, r)
					keep[#keep + 1] = r
				end
			end
			reg = keep
		end

		local function loadBoard()
			if bBusy then return end
			bBusy = true
			task.spawn(function()
				local ok, data = FS.req("GET", "/followers")
				if ok and type(data) == "table" then
					local list, c2 = {}, {}
					for id, ups in pairs(data) do
						if type(ups) == "table" and tostring(id):match("^%d+$") then
							local n = 0
							for _ in pairs(ups) do n = n + 1 end
							if n > 0 then
								c2[tostring(id)] = n
								list[#list + 1] = { id = tostring(id), c = n }
							end
						end
					end
					table.sort(list, function(a, b)
						if a.c ~= b.c then return a.c > b.c end
						return a.id < b.id
					end)
					local r2 = {}
					for i = 1, math.min(CONFIG.TOP_RANK_TAG or 50, #list) do r2[list[i].id] = i end
					counts, rankOf, bStamp = c2, r2, os.clock()
					for id, n in pairs(c2) do FS.cache[id] = { c = n, t = os.clock() } end
					T.boardOk = true
					-- Tier IV players' own frame pick (1 or 2), kept in the DM database; unreadable = everybody gets frame 1
					local okc, ch = dbRequest("GET", "/frames", nil, dmAuth, DM_FIREBASE_DB)
					if okc and type(ch) == "table" then
						local m = {}
						for id, v in pairs(ch) do if v == 1 or v == 2 then m[tostring(id)] = v end end
						local mine = T.frameChoice and T.frameChoice[ME]
						if mine and not m[ME] then m[ME] = mine end
						T.frameChoice = m
					end
				else
					bStamp = os.clock() - 60 -- failed: try again in ~30s
				end
				bBusy = false
				pcall(repaintAll)
				if T.refreshFrames then pcall(T.refreshFrames) end
			end)
		end

		function T.boardCount(id) return counts[id] end
		function T.boardRank(id) return rankOf[id] end
		function T.boardLoaded() return T.boardOk == true end
		function T.boardNeeded() if os.clock() - bStamp > 90 then loadBoard() end end

		function T.decorateName(row, id)
			reg[#reg + 1] = { row = row, id = id }
			paint(reg[#reg])
			if os.clock() - bStamp > 90 then loadBoard() end
		end

		task.spawn(function() -- keep tags fresh while the chat is in use
			while true do
				task.wait(30)
				if (#reg > 0 or isOpen) and os.clock() - bStamp > 90 then loadBoard() end
			end
		end)
	end
end

