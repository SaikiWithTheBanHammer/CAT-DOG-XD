		local counts, rankOf = {}, {}
		local bStamp, bBusy = -1e9, false
		local reg = {} -- { row = nameRow, id = userId, title = label, rank = label }

		local function pill(parent, order, text, col, strong)
			local l = new("TextLabel", { Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = col,
				BackgroundTransparency = strong and 0.78 or 0.86, Text = text, Font = T.fontB, TextSize = 10, TextColor3 = col,
				LayoutOrder = order, Parent = parent }, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
