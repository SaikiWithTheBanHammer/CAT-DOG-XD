        if sound and sound.IsLoaded and sound.TimeLength > 0 then
            local ratio = math.clamp(
                (input.Position.X - progressTrack.AbsolutePosition.X)
                    / progressTrack.AbsoluteSize.X,
                0,
                1
            )

            sound.TimePosition = ratio * sound.TimeLength
        end
    end
end)

closeButton.MouseButton1Click:Connect(function()
    player.generation += 1
    destroySound()
    gui:Destroy()
end)

task.spawn(function()
    while gui.Parent do
        local sound = player.sound

        if sound and sound.Parent and sound.IsLoaded and sound.TimeLength > 0 then
            local ratio = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)

            progressFill.Size = UDim2.new(ratio, 0, 1, 0)

            timeLabel.Text = formatTime(sound.TimePosition)
                .. " / " .. formatTime(sound.TimeLength)

            if sound.IsPlaying then
                pauseButton.Text = "PAUSE"
            else
                pauseButton.Text = "PLAY"
            end
        end

        task.wait(0.25)
    end
end)

local allResults = {}
local currentPage = 1
local currentQuery = ""
local nextPageToken = nil
local searchGeneration = 0
local isLoading = false
local noMorePages = false

local function clearResults()
    channelLabels = {}

    for _, child in ipairs(resultsFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function showMessage(message)
