local httpRequest =
    (syn and syn.request)
    or (http and http.request)
    or http_request
    or request

local function httpGet(url)
    assert(httpRequest, "Your executor does not provide request/http_request.")

    local response = httpRequest({
        Url = url,
        Method = "GET",
        Headers = {
            ["Accept"] = "application/json"
        }
    })

    if not response then
        error("No response from YouTube.")
    end

    local status = response.StatusCode or response.Status or 200
    local body = response.Body or response.body

    if tonumber(status) and tonumber(status) >= 400 then
        local message = tostring(body or "HTTP error")
        local decoded = nil

        pcall(function()
            decoded = HttpService:JSONDecode(message)
        end)

        if decoded and decoded.error then
            message = decoded.error.message or message
        end

        error("HTTP " .. tostring(status) .. ": " .. message)
    end

    if type(body) ~= "string" then
        error("The HTTP response did not contain text.")
    end

    local data = HttpService:JSONDecode(body)

    if data.error then
        error(
            tostring(data.error.code or "")
            .. " - "
            .. tostring(data.error.message or "YouTube API error")
        )
    end

    return data
end

local function safeGet(url)
    local ok, response = pcall(httpRequest, {
        Url = url,
        Method = "GET"
    })

    if not ok or not response then
        return nil
    end

    local body = response.Body or response.body

    if type(body) ~= "string" or #body == 0 then
        return nil
    end

    return body
end

local function decodeJson(body)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if ok and type(data) == "table" then
        return data
    end

    return nil
end

local function copyText(value)
    if setclipboard then
        setclipboard(value)
        return true
    elseif toclipboard then
        toclipboard(value)
        return true
    elseif Clipboard and Clipboard.set then
        Clipboard.set(value)
        return true
    end

    return false
end

local function encodeURL(value)
    return (tostring(value):gsub("([^%w%-_%.~])", function(char)
        return string.format("%%%02X", string.byte(char))
    end))
end

local function trim(value)
    return (value:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function formatTime(seconds)
    seconds = math.max(0, seconds or 0)

    return string.format(
        "%d:%02d",
        math.floor(seconds / 60),
        math.floor(seconds % 60)
    )
end

local function parseDuration(value)
    if type(value) ~= "string" or value:sub(1, 1) ~= "P" then
        return "Unavailable", nil
    end

    local days = tonumber(value:match("(%d+)D")) or 0
    local timePart = value:match("T(.*)") or ""

    local hours = tonumber(timePart:match("(%d+)H")) or 0
    local minutes = tonumber(timePart:match("(%d+)M")) or 0
    local seconds = tonumber(timePart:match("(%d+)S")) or 0

    local total = days * 86400 + hours * 3600
        + minutes * 60 + seconds

    local formatted

    if total >= 3600 then
        formatted = string.format(
            "%d:%02d:%02d",
            math.floor(total / 3600),
            math.floor((total % 3600) / 60),
            total % 60
        )
    else
        formatted = string.format(
            "%d:%02d",
            math.floor(total / 60),
            total % 60
        )
    end

    return formatted, total
end

local function extractVideoId(text)
    local lowered = text:lower()

    if not (lowered:find("youtube.com", 1, true) or lowered:find("youtu.be", 1, true)) then
        return nil
    end

    local candidate = text:match("youtu%.be/([%w_%-]+)")
        or text:match("[?&]v=([%w_%-]+)")
        or text:match("/shorts/([%w_%-]+)")
        or text:match("/embed/([%w_%-]+)")
        or text:match("/live/([%w_%-]+)")

    if candidate and #candidate >= 11 then
        return candidate:sub(1, 11)
    end

    return nil
end

local function make(className, properties, parentObject)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parentObject
    return object
end

