local function requestJSON(method, url, body, headers)
	if not REQUEST then return false, nil, "no request function" end
	local opts = { Url = url, Method = method, Headers = { ["Content-Type"] = "application/json" } }
	if headers then for k, v in pairs(headers) do opts.Headers[k] = v end end
	if body ~= nil then opts.Body = (type(body) == "string") and body or HttpService:JSONEncode(body) end
	local ok, res = pcall(REQUEST, opts)
	if not ok or not res then
		if T.guardFail then pcall(T.guardFail, res) end
		return false, nil, tostring(res)
	end
	local code = tonumber(res.StatusCode or res.Status or 0) or 0
	local raw = res.Body or res.body or ""
	local decoded
	if raw ~= "" then pcall(function() decoded = HttpService:JSONDecode(raw) end) end
	if T.guardNote then pcall(T.guardNote, code >= 200 and code < 300, code, url) end
	return code >= 200 and code < 300, decoded, raw, code
end

local function dbURL(base, path, token, extra)
	local url, q = base .. path .. ".json", {}
	if token and token ~= "" then q[#q + 1] = "auth=" .. enc(token) end
	if extra and extra ~= "" then q[#q + 1] = extra end
	if #q > 0 then url = url .. "?" .. table.concat(q, "&") end
	return url
end

