end

local function renderPage()
    clearResults()

    local firstIndex = (currentPage - 1) * 10 + 1
    local lastIndex = math.min(firstIndex + 9, #allResults)

    if firstIndex > #allResults then
        showMessage("No results on this page.")
    else
        for index = firstIndex, lastIndex do
            addResultCard(allResults[index], index)
        end
    end

    pageLabel.Text = "Page " .. tostring(currentPage)

    previousButton.Active = currentPage > 1 and not isLoading
    previousButton.AutoButtonColor = previousButton.Active

    nextButton.Active = not isLoading
    nextButton.AutoButtonColor = nextButton.Active
end

local function fetchBatch(generation, query)
    if isLoading or noMorePages then
        return
    end

    isLoading = true
    setStatus("Searching YouTube and loading durations...", LIGHT)
    updateFooter()

    task.spawn(function()
        local ok, err = pcall(function()
            local url = "https://www.googleapis.com/youtube/v3/search"
                .. "?part=snippet&type=video&maxResults=50"
                .. "&q=" .. encodeURL(query)
                .. "&key=" .. encodeURL(API_KEY)

            if nextPageToken then
                url = url .. "&pageToken=" .. encodeURL(nextPageToken)
            end

            local searchData = httpGet(url)

            if generation ~= searchGeneration then
                return
            end

            nextPageToken = searchData.nextPageToken
            noMorePages = not nextPageToken

            local ids = {}
            local snippetsById = {}

            for _, item in ipairs(searchData.items or {}) do
                local id = item.id and item.id.videoId

                if id then
                    table.insert(ids, id)
                    snippetsById[id] = item.snippet or {}
                end
            end

            if #ids == 0 then
                return
            end

            local detailsURL =
                "https://www.googleapis.com/youtube/v3/videos"
                .. "?part=contentDetails&id="
                .. encodeURL(table.concat(ids, ","))
                .. "&key=" .. encodeURL(API_KEY)

            local detailsData = httpGet(detailsURL)

            if generation ~= searchGeneration then
                return
            end

            local durationById = {}

            for _, item in ipairs(detailsData.items or {}) do
                local formatted, seconds =
                    parseDuration(item.contentDetails
                        and item.contentDetails.duration)

                durationById[item.id] = {
                    formatted = formatted,
                    seconds = seconds
                }
            end

            for _, id in ipairs(ids) do
                local duration = durationById[id]

                if duration and duration.seconds
                    and duration.seconds >= 60 then

                    local snippet = snippetsById[id] or {}

                    table.insert(allResults, {
                        id = id,
                        title = snippet.title or "Untitled video",
                        channel = snippet.channelTitle or "Unknown channel",
                        duration = duration.formatted
                    })
                end
            end
        end)

        if generation ~= searchGeneration then
            return
        end

        isLoading = false

        if not ok then
            setStatus("API error: " .. tostring(err), RED)
        elseif #allResults == 0 and noMorePages then
            setStatus("No videos of 60 seconds or longer were found.", LIGHT)
        else
            setStatus(
                "Loaded " .. tostring(#allResults)
                    .. " eligible videos. Press PLAY AUDIO to listen.",
                GREEN
            )
        end

        renderPage()
        updateFooter()
    end)
end

local function startSearch()
    local query = trim(searchBox.Text)

    if query == "" then
        setStatus("Type something to search for.", ORANGE)
        return
    end

    local linkedId = extractVideoId(query)

    if linkedId then
        playVideo({
            id = linkedId
        })
        return
    end

    searchGeneration += 1
    local generation = searchGeneration

    allResults = {}
    currentPage = 1
    currentQuery = query
    nextPageToken = nil
    noMorePages = false
    isLoading = false

    showMessage("Searching...")
    fetchBatch(generation, query)
end

searchButton.MouseButton1Click:Connect(startSearch)

searchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        startSearch()
    end
end)

previousButton.MouseButton1Click:Connect(function()
    if isLoading or currentPage <= 1 then
        return
    end

    currentPage -= 1
    renderPage()
end)

nextButton.MouseButton1Click:Connect(function()
    if isLoading then
        return
    end

    local nextFirstIndex = currentPage * 10 + 1

    if nextFirstIndex <= #allResults then
        currentPage += 1
        renderPage()
        return
    end

    if not noMorePages then
        currentPage += 1
        fetchBatch(searchGeneration, currentQuery)
    else
        setStatus("No more results.", LIGHT)
    end
end)

showMessage("Search YouTube to see results here.")
updateFooter()
