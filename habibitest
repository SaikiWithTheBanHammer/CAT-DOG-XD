---------------------------------------------------------------- Tier II: Angel Halo
local function buildHalo(model)
	local SEG, RADIUS, HEIGHT, THICK, SPEED = 31, 2.0, 2.3, 0.22, 0.8
	local GOLD, WHITEC = Color3.fromRGB(255, 235, 140), Color3.fromRGB(255, 255, 255)
	local parts, joints, border, pos = {}, {}, {}, {}
	local function neon(shape, color)
		local p = Instance.new("Part")
		p.Material = Enum.Material.Neon
		p.Shape = shape
		p.Anchored = true
		p.CanCollide = false
		p.CastShadow = false
		p.Color = color
		p.Parent = model
		return p
	end
	for i = 1, SEG do
		parts[i] = neon(Enum.PartType.Cylinder, GOLD)
		joints[i] = neon(Enum.PartType.Ball, GOLD)
		border[i] = neon(Enum.PartType.Cylinder, WHITEC)
	end
	acquireBloom()
	local rotation = 0
	return {
		update = function(char, dt, t)
			local head = char:FindFirstChild("Head")
			if not head then return end
			rotation = rotation + dt * SPEED
			local center = head.CFrame * CFrame.new(0, HEIGHT, 0) * CFrame.Angles(0, rotation, 0)
			for i = 1, SEG + 1 do
				local angle = (i / SEG) * math.pi * 2
				local wave = math.sin(t * 1.2 + angle) * 0.02
				pos[i] = center * Vector3.new(math.cos(angle) * RADIUS, wave, math.sin(angle) * RADIUS)
			end
			for i = 1, SEG do
				local p1, p2 = pos[i], pos[i + 1]
				local len = (p2 - p1).Magnitude
				local cf = CFrame.lookAt(p1:Lerp(p2, 0.5), p2) * CFrame.Angles(0, math.rad(90), 0)
				parts[i].Size = Vector3.new(len, THICK, THICK)
				parts[i].CFrame = cf
				joints[i].Size = Vector3.new(THICK * 1.3, THICK * 1.3, THICK * 1.3)
				joints[i].CFrame = CFrame.new(p1)
				border[i].Size = Vector3.new(len + 0.05, 0.06, 0.06)
				border[i].CFrame = cf
			end
		end,
		destroy = releaseBloom,
	}
end

