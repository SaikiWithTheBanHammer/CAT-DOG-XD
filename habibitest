-- one place that draws a server-chat message: normal bubble, or (for "!anc text" from a high enough tier) the announcement banner
function T.playAnc()
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = "rbxassetid://" .. tostring(CONFIG.ANNOUNCE_SOUND)
		s.Volume = 1
		s.Parent = game:GetService("SoundService")
		s.Ended:Connect(function() s:Destroy() end)
		task.delay(30, function() if s.Parent then s:Destroy() end end)
		s:Play()
	end)
end
function T.showServer(uid, name, text, stk, key, reply, silent)
	local function plain()
		views[1].add({ uid = uid, name = name, text = text, stk = stk, key = key, reply = reply })
		if not silent then markUnread(1, uid) end
		if not silent and not isOpen and tostring(uid) ~= ME and T.notify then -- window closed: pop-up for new server chat messages
			T.notify("srv", "Server chat  ·  " .. name, stk and "Sticker" or text)
		end
	end
	if (not stk) and text == (CONFIG.WELCOME_TEXT or "joined Saiki Rechat") then -- quiet welcome line (no unread dot, no sound, no pop-up)
		views[1].addWelcome({ name = name, color = T.tierColor and T.tierColor(uid) or nil })
		return
	end
	local body = (not stk) and type(text) == "string" and text:lower():sub(1, 5) == "!anc " and text:match("^%S+%s+(.+)$")
	if not body then plain(); return end
	local function decide(tier)
		if tier and tier >= (CONFIG.ANNOUNCE_MIN_TIER or 4) then
			views[1].addAnnouncement({ name = name, text = body, title = CONFIG.TITLES and CONFIG.TITLES[tier] or "" })
			if not silent then
				T.playAnc()
				markUnread(1, uid)
				if not isOpen and T.notify then T.notify("anc", "Announcement  ·  " .. name, body) end
			end
		else
			plain() -- sender isn't allowed to announce: it's just a normal message
		end
	end
	local tier = T.annTier and T.annTier(uid, false)
	if tier ~= nil then decide(tier) else task.spawn(function() decide(T.annTier and T.annTier(uid, true)) end) end
end

local function serverHandler(key, m, silent)
	local uid = tonumber(m.uid)
	if not uid or banned[uid] then return end
	local text, stk = parseMsg(m)
	if not text then return end
	local p = Players:GetPlayerByUserId(uid)
	local name = p and p.DisplayName or (type(m.dn) == "string" and m.dn:sub(1, 40)) or "Player"
	T.showServer(uid, name, text, stk, key, parseReply(m), silent)
end
if REQUEST then task.spawn(function() pollStream(serverStream, serverHandler) end) end -- remember "now", draw nothing old

