    make("TextLabel", {
        Size = UDim2.new(1, -8, 0, 70),
        BackgroundTransparency = 1,
        Text = message,
        TextColor3 = Color3.fromRGB(185, 189, 202),
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextWrapped = true
