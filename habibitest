local function dbRequest(method, path, body, target, base, extra)
	target, base = target or auth, base or FIREBASE_DB
	if not ensureToken(target) then return false, nil, "auth failed: " .. tostring(target.err), nil end
	local used, refreshed, tries = target.token, false, 0
	local ok, data, raw, code
	while true do
		tries = tries + 1
		ok, data, raw, code = requestJSON(method, dbURL(base, path, used, extra), body)
		if ok then break end
		if code == 401 and not refreshed then
			refreshed = true -- token may have just expired: renew once and retry
			if not ensureToken(target, true, used) then break end
			used = target.token
		elseif tries < 3 and (code == nil or code == 0 or code == 429 or code >= 500) then
			task.wait(0.5 * tries) -- transient network / server hiccup
		else
			break
		end
	end
	return ok, data, raw, code
end

