local function runSearch(mode)
    if busy then return end

    if mode == "new" then
        query = searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then
            status.Text = "Enter a search term first."
            return
        end
        pageNumber = 1
        pageTokens = {false}
    elseif mode == "next" then
        if not canNext or not nextToken then return end
        pageNumber += 1
        pageTokens[pageNumber] = nextToken
    elseif mode == "prev" then
        if pageNumber <= 1 then return end
        pageNumber -= 1
    end

    busy = true
    searchButton.Text = "..."
    status.Text = "Loading results and video lengths..."
    clearResults()
    updateButtons()

    task.spawn(function()
        local ok, err = pcall(function()
            local token = pageTokens[pageNumber]
            local url = "https://www.googleapis.com/youtube/v3/search"
                .. "?part=snippet&type=video&maxResults=10"
                .. "&q=" .. encode(query)
                .. "&key=" .. encode(API_KEY)

            if token and token ~= false then
                url = url .. "&pageToken=" .. encode(token)
            end

            local data = get(url)
            nextToken = data.nextPageToken
            canNext = nextToken ~= nil

            local items = data.items or {}
            local ids = {}
            for _, item in ipairs(items) do
                if item.id and item.id.videoId then
                    table.insert(ids, item.id.videoId)
                end
            end

            if #ids == 0 then
                status.Text = "No videos found."
                return
            end

            -- IMPORTANT: request duration metadata using video IDs.
            -- Leave commas between IDs intact.
            local detailsUrl =
                "https://www.googleapis.com/youtube/v3/videos"
                .. "?part=contentDetails&id="
                .. table.concat(ids, ",")
                .. "&key=" .. encode(API_KEY)

            local detailData = get(detailsUrl)
            local durationById = {}

            for _, video in ipairs(detailData.items or {}) do
                local iso = video.contentDetails
                    and video.contentDetails.duration

                local formatted, seconds = parseDuration(iso)
                if formatted then
                    durationById[tostring(video.id)] = {
                        text = formatted,
                        seconds = seconds
                    }
                end
            end

            local shown, skipped, missing = 0, 0, 0

            for _, item in ipairs(items) do
                local videoId = tostring(item.id.videoId)
                local info = durationById[videoId]

                if info and info.seconds < 60 then
                    skipped += 1
                else
                    shown += 1
                    if info then
                        createCard(shown, item, info.text)
                    else
                        missing += 1
                        createCard(shown, item, "Unavailable")
                    end
                end
            end

            status.Text = string.format(
                "%d results | %d Shorts/short videos skipped | %d durations unavailable",
                shown, skipped, missing
            )

            if missing > 0 then
                status.Text ..= " — check API key/quota if persistent"
            end
        end)

        busy = false
        searchButton.Text = "SEARCH"
        updateButtons()

        if not ok then
            status.Text = "API error: " .. tostring(err)
        end
    end)
end

