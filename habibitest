		btn("Kill Errors", 254, 212, 110, nil, function() run("Clearing errors", doKillErrors) end)
		btn("Kill Ares / BxD restrictions", 16, 256, 348, T.red, function() run("Killing Ares/BxD", doKillAres) end)
		local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, Text = "×", Font = T.fontB, TextSize = 16, TextColor3 = T.text,
			AutoButtonColor = false, ZIndex = 301, Parent = dlg }, { corner(12) })
		x.Activated:Connect(hide)
	end

	function T.guardShow()
		if dlg or not alive or os.clock() < st.nextAt then return end
		st.nextAt = os.clock() + 120
		task.defer(show)
	end
	-- called by the HTTP layer after every call
	function T.guardNote(good, code, url)
		if good then st.fails = 0; return end
		url = tostring(url)
		if not (url:find("firebaseio%.com") or url:find("googleapis%.com")) then return end
		st.lastErr = (code and code > 0) and ("HTTP " .. code) or "no response"
