----------------------------------------------------------------- stream helper
local function newStream(path, tAuth, base)
	return { path = path, auth = tAuth, base = base, last = nil, seen = {}, primed = false }
end
local function pollStream(s, handler)
	-- skipOld streams: the very first poll only remembers the newest message (nothing is drawn),
	-- so only messages sent after the script loaded ever show up
	local priming = s.skipOld and not s.primed
	local extra = priming and 'orderBy="$key"&limitToLast=1'
		or (s.last and ('orderBy="$key"&startAt="' .. s.last .. '"'))
		or ('orderBy="$key"&limitToLast=' .. CONFIG.HISTORY)
	local ok, data = dbRequest("GET", s.path, nil, s.auth, s.base, extra)
	if not ok then return end
	if priming and s.primed then priming = false end -- another poll finished priming while this one was in flight
	if type(data) == "table" then
		local rows = {}
		for k, v in pairs(data) do if type(v) == "table" then rows[#rows + 1] = { k = tostring(k), v = v } end end
		table.sort(rows, function(a, b) return a.k < b.k end)
		for _, it in ipairs(rows) do
			if not s.last or it.k > s.last then s.last = it.k end
			if not s.seen[it.k] then
				s.seen[it.k] = true
				if not priming then handler(it.k, it.v, not s.primed) end
			end
		end
	end
	s.primed = true
end

local function payload(p)
	local d = { uid = ME, dn = cut(LP.DisplayName, 40), un = cut(LP.Name, 40), pfp = 1,
		txt = p.stk and "[sticker]" or cut(p.text, 200), stk = p.stk, ts = SV }
	if p.reply then d.rk, d.rn, d.rt = cut(p.reply.k, 40), cut(p.reply.n, 40), cut(p.reply.t, 60) end
	return d
end
local function parseReply(m)
	if type(m.rk) == "string" and type(m.rn) == "string" and type(m.rt) == "string" and m.rk ~= "" then
		return { k = cut(m.rk, 40), n = cut(clean(m.rn), 40), t = cut(clean(m.rt), 60) }
	end
	return nil
end
local function sendFail(view, raw, code, dbName)
	warn("[SAIKI RECHAT] send failed on " .. tostring(dbName or "?") .. " (HTTP " .. tostring(code) .. "): " .. tostring(raw):sub(1, 300))
	local why
	if code == 401 or code == 403 then
		local msg = tostring(raw):match('"error"%s*:%s*"([^"]+)"') or "denied"
		why = tostring(dbName or "database") .. " refused the write (" .. code .. ": " .. msg .. "). Publish the latest rules for that project"
	elseif code == 400 then why = "Firebase rejected the request (400)"
	elseif not code then why = tostring(raw or "no response"):sub(1, 90)
	else why = "HTTP " .. tostring(code) end
	view.notice("Couldn't send: " .. why)
end

local function parseMsg(m)
	local text = clean(m.txt or m.text or "")
	local stk = validSticker(m.stk)
	if stk then text = "" end
	if text == "" and not stk then return nil end
	return text, stk
end

-- DM identity: registers "this Roblox id belongs to this DM login" in the DM database (the DM rules check it).
-- Best effort + retried: if it can't be registered, Firebase's own error shows up when you send.
do
	local st = { ok = false, busy = false, retryAt = 0, warned = false }
	function T.dmIdReset() st.ok, st.busy, st.retryAt, st.warned = false, false, 0, false end
	function T.dmId()
		if st.ok or not REQUEST then return st.ok end
		if st.busy then
			local w = 0
			while st.busy and w < 15 do task.wait(0.1); w = w + 0.1 end
			return st.ok
		end
		if os.clock() < st.retryAt then return false end
		st.busy = true
		local good, why = false, nil
		if ensureToken(dmAuth) and dmAuth.uid then
			local uid = tostring(dmAuth.uid)
			local ok1, _, _, c1 = dbRequest("PUT", "/users/" .. ME, '"' .. uid .. '"', dmAuth, DM_FIREBASE_DB)
			if ok1 then
				local ok2, _, _, c2 = dbRequest("PUT", "/uidmap/" .. uid, '"' .. ME .. '"', dmAuth, DM_FIREBASE_DB)
				good = ok2 and true or false
				if not ok2 then why = "uidmap HTTP " .. tostring(c2) end
			else
				why = "users HTTP " .. tostring(c1)
			end
		else
			why = "DM login not ready"
		end
		st.ok, st.busy = good, false
		if not good then
			st.retryAt = os.clock() + 30
			if not st.warned then
				st.warned = true
				warn("[SAIKI RECHAT] DM identity not registered (" .. tostring(why) .. "). Publish the new sxkidirect rules; if this Roblox id was linked to another DM login, delete /users/" .. ME .. " in the Firebase console.")
			end
		end
		return good
	end
end

