----------------------------------------------------------------- identity guard loop (every ~45s)
task.spawn(function()
	local strikes, rounds = 0, 0
	while alive do
		task.wait(CONFIG.IDENTITY_INTERVAL)
		if not alive then break end
		rounds += 1
		local r = checkIdentity(false) -- display name is only compared with the API at launch
		if r == "spoof" then
			kick(KICK_SPOOF); Destroy(); break
		elseif r == "mismatch" then
			strikes += 1
			if strikes >= 2 then kick(KICK_SPOOF); Destroy(); break end
		elseif r == "ok" then
			strikes = 0
		end
		if rounds % 13 == 0 then -- ~every 10 minutes
			loadBanList()
			if isBanned() then kick(KICK_BAN); Destroy(); break end
		end
	end
end)

