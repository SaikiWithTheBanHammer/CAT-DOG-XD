local function sliderShow(v)
	if not (sBar and sBar.Parent) then return end
	local f = (v - MINROWS) / (MAXROWS - MINROWS)
	sFill.Size = UDim2.fromScale(f, 1)
	sKnob.Position = UDim2.fromScale(f, 0.5)
	sVal.Text = "Top " .. v
end

local function sliderFromX(x)
	if not (sBar and sBar.Parent) then return end
	local f = math.clamp((x - sBar.AbsolutePosition.X) / math.max(1, sBar.AbsoluteSize.X), 0, 1)
	local v = math.floor((MINROWS + f * (MAXROWS - MINROWS)) / STEPROWS + 0.5) * STEPROWS
	pendVal = math.clamp(v, MINROWS, MAXROWS)
	sliderShow(pendVal)
end

local function applyLimit()
