	dmStream = newStream("/dm/" .. pair, dmAuth, DM_FIREBASE_DB)
	dmStream.rpath = "/dmreact/" .. pair
	views.dm.clear()
	-- 1) draw what's already on this device (no network)
	for _, st in ipairs(activeConv) do dmStream.seen[st.k] = true end -- so Firebase's copy is never drawn twice
	if #activeConv > 0 then dmStream.last = activeConv[#activeConv].k; dmStream.primed = true end
	for i = math.max(1, #activeConv - CONFIG.DM_SHOW + 1), #activeConv do renderStored(activeConv[i]) end
