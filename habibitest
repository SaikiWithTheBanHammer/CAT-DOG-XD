-- Helpers
local function urlEncode(str)
    return str:gsub("([^%w%-%.%_%~])", function(c)
        return string.format("%%%02X", c:byte())
    end)
end

local function httpGet(url)
    local success, res = pcall(function()
        return req({Url = url, Method = "GET"})
    end)
    if success and res and res.Body then
        return res.Body
    end
    return nil
end

local activeSound = nil

local function playAudioFile(filePath, trackTitle)
    if activeSound then
        pcall(function() activeSound:Stop(); activeSound:Destroy() end)
    end

    statusText.Text = "Status: Loading Asset..."
    local assetId = getasset(filePath)
    
    local sound = Instance.new("Sound")
    sound.Name = "SyncMusicNode"
    sound.SoundId = assetId
    sound.Volume = 0.8
    sound.Parent = workspace
    
    sound:Play()
    activeSound = sound
    
    trackTitleLabel.Text = "Playing: " .. trackTitle
    statusText.Text = "Status: Playing (Synced)"
end

local function downloadAndPlayYouTube(youtubeUrl, title)
    statusText.Text = "Status: Requesting conversion..."
    local apiEncodeUrl = "https://p.savenow.to/ajax/download.php?url=" .. urlEncode(youtubeUrl) .. "&format=mp3&apikey=21fbd971d02303568cf35043e7993dafc4ddf260"
    
    local body = httpGet(apiEncodeUrl)
    if not body then
        statusText.Text = "Status: Error - Conversion API failed"
        return
    end
    
    local success, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not success or not data or not data.id then
        statusText.Text = "Status: Error - Bad conversion response"
        return
    end
    
    local downloadId = data.id
    statusText.Text = "Status: Converting audio (0%)..."
    
    local audioDownloadUrl = nil
    for i = 1, 60 do
        task.wait(2)
        local progBody = httpGet("https://p.savenow.to/ajax/progress.php?id=" .. downloadId)
        if progBody then
            local pSucc, pData = pcall(function() return HttpService:JSONDecode(progBody) end)
            if pSucc and pData then
                local progNum = tonumber(pData.progress) or 0
                statusText.Text = "Status: Converting (" .. tostring(math.clamp(progNum, 0, 100)) .. "%)"
                if progNum >= 1000 and pData.download_url then
                    audioDownloadUrl = pData.download_url
                    break
                end
            end
        end
    end
    
    if not audioDownloadUrl then
        statusText.Text = "Status: Error - Conversion timed out"
        return
    end
    
    statusText.Text = "Status: Downloading MP3 bytes..."
    local mp3Res = req({Url = audioDownloadUrl, Method = "GET"})
    if not mp3Res or not mp3Res.Body then
        statusText.Text = "Status: Error - MP3 download failed"
        return
    end
    
    local fileName = FOLDER_NAME .. "tat_" .. downloadId .. ".mp3"
    writefile(fileName, mp3Res.Body)
    playAudioFile(fileName, title)
end

local function processSelectedTrack(youtubeUrl, title)
    local cachedPath = nil
    for _, file in ipairs(listfiles(FOLDER_NAME)) do
        if file:match("%.mp3$") and file:find(youtubeUrl:match("v=([%w_-]+)") or "") then
            cachedPath = file
            break
        end
    end
    
    if cachedPath then
        statusText.Text = "Status: Loaded from local cache (Instant)!"
        playAudioFile(cachedPath, title)
    else
        downloadAndPlayYouTube(youtubeUrl, title)
    end
end

-- Firebase Sync Listener
local lastPlayedTimestamp = 0
task.spawn(function()
    while screenGui.Parent do
        task.wait(3)
        local resBody = httpGet(FIREBASE_BASE_URL)
        if resBody and resBody ~= "null" then
            local s, parsed = pcall(function() return HttpService:JSONDecode(resBody) end)
            if s and parsed and parsed.current_song then
                local song = parsed.current_song
                if song.timestamp and song.timestamp > lastPlayedTimestamp then
                    lastPlayedTimestamp = song.timestamp
                    processSelectedTrack(song.url, song.title)
                end
            end
        end
    end
end)

local function pushToFirebase(youtubeUrl, title)
    local payload = HttpService:JSONEncode({
        url = youtubeUrl,
        title = title,
        timestamp = os.time()
    })
    pcall(function()
        req({
            Url = FIREBASE_BASE_URL,
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
end

local function parseDuration(iso)
    local m = tonumber(iso:match("(%d+)M")) or 0
    local s = tonumber(iso:match("(%d+)S")) or 0
    local h = tonumber(iso:match("(%d+)H")) or 0
    return (h * 3600) + (m * 60) + s
end

local currentQuery = ""
local nextPageToken = nil

local function renderSearchResults(query, pageToken)
    currentQuery = query
    scrollList:ClearAllChildren()
    listLayout.Parent = scrollList
    
    statusText.Text = "Status: Searching YouTube..."
    local searchUrl = "https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&maxResults=10&q=" .. urlEncode(query) .. "&key=" .. YOUTUBE_API_KEY
    if pageToken then
        searchUrl = searchUrl .. "&pageToken=" .. pageToken
    end
    
    local success, res = pcall(function()
        return req({Url = searchUrl, Method = "GET"})
    end)
    
    if not success or not res or not res.Body then
        statusText.Text = "Status: Network request failed"
        return
    end
    
    print("[Debug] API Response Code:", res.StatusCode)
    local sData = HttpService:JSONDecode(res.Body)
    if sData.error then
        statusText.Text = "Status: API Error (" .. tostring(sData.error.code) .. ")"
        warn("[YouTube API Error]: " .. tostring(sData.error.message))
        return
    end
    
    if not sData or not sData.items or #sData.items == 0 then
        statusText.Text = "Status: No results found"
        return
    end
    
    nextPageToken = sData.nextPageToken
    
    local ids = {}
    for _, item in ipairs(sData.items) do
        if item.id and item.id.videoId then table.insert(ids, item.id.videoId) end
    end
    
    local detailsUrl = "https://www.googleapis.com/youtube/v3/videos?part=contentDetails&id=" .. table.concat(ids, ",") .. "&key=" .. YOUTUBE_API_KEY
    local dBody = httpGet(detailsUrl)
    local durations = {}
    if dBody then
        local dData = HttpService:JSONDecode(dBody)
        if dData and dData.items then
            for _, dItem in ipairs(dData.items) do
                durations[dItem.id] = parseDuration(dItem.contentDetails.duration)
            end
        end
    end
    
    local totalItems = 0
    for _, item in ipairs(sData.items) do
        if item.id and item.id.videoId then
            local vId = item.id.videoId
            local dur = durations[vId] or 0
            
            if dur <= 300 then -- Max 5 mins filter
                totalItems = totalItems + 1
                local itemFrame = Instance.new("Frame", scrollList)
                itemFrame.Size = UDim2.new(1, -4, 0, 42)
                itemFrame.BackgroundColor3 = c_card
                applyCorner(6, itemFrame)
                
                -- Red warning border for videos between 3 to 5 minutes
                if dur > 180 then
                    local strokeWarn = Instance.new("UIStroke", itemFrame)
                    strokeWarn.Color = c_red
                    strokeWarn.Thickness = 1.3
                end
                
                local btn = Instance.new("TextButton", itemFrame)
                btn.Size = UDim2.new(1, -8, 1, 0)
                btn.Position = UDim2.fromOffset(4, 0)
                btn.BackgroundTransparency = 1
                btn.Text = item.snippet.title
                btn.TextColor3 = c_text
                btn.TextSize = 10
                btn.Font = Enum.Font.Gotham
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.TextTruncate = Enum.TextTruncate.AtEnd
                
                if dur > 180 then
                    local warnLabel = Instance.new("TextLabel", itemFrame)
                    warnLabel.Size = UDim2.new(1, -10, 0, 12)
                    warnLabel.Position = UDim2.fromOffset(6, 26)
                    warnLabel.BackgroundTransparency = 1
                    warnLabel.Text = "⚠️ Long video: may take longer to load first time."
                    warnLabel.TextColor3 = c_red
                    warnLabel.TextSize = 8
                    warnLabel.Font = Enum.Font.GothamBold
                    warnLabel.TextXAlignment = Enum.TextXAlignment.Left
                    btn.Size = UDim2.new(1, -8, 0, 26)
                end
                
                local targetUrl = "https://www.youtube.com/watch?v=" .. vId
                local targetTitle = item.snippet.title
                
                btn.Activated:Connect(function()
                    pushToFirebase(targetUrl, targetTitle)
                end)
            end
        end
    end
    
    if nextPageToken then
        totalItems = totalItems + 1
        local moreBtn = Instance.new("TextButton", scrollList)
        moreBtn.Size = UDim2.new(1, -4, 0, 32)
        moreBtn.BackgroundColor3 = c_accent
        moreBtn.Text = "Load Next 10 Results"
        moreBtn.TextColor3 = c_text
        moreBtn.Font = Enum.Font.GothamBold
        moreBtn.TextSize = 10
        applyCorner(6, moreBtn)
        
        moreBtn.Activated:Connect(function()
            renderSearchResults(currentQuery, nextPageToken)
        end)
    end
    
    scrollList.CanvasSize = UDim2.new(0, 0, 0, totalItems * 48)
    statusText.Text = "Status: Ready"
end

