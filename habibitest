local function errText(data, raw)
	if type(data) == "table" and type(data.error) == "table" and data.error.message then return tostring(data.error.message):sub(1, 120) end
	return tostring(raw or "no response"):sub(1, 120)
end
local function applyToken(t, idToken, refresh, uid, expires)
	t.token = idToken
	if refresh then t.refresh = refresh end
	if uid then t.uid = uid end
	t.exp = os.time() + (tonumber(expires) or 3600) - 180 -- renew 3 minutes BEFORE it expires
	t.err = nil
end
local function signUp(t)
	local ok, data, raw = requestJSON("POST", "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. t.key, { returnSecureToken = true })
	if ok and type(data) == "table" and data.idToken then
		applyToken(t, data.idToken, data.refreshToken, data.localId, data.expiresIn)
		saveSession(t)
		return true
	end
	t.err = errText(data, raw)
	return false
end
local function refreshTok(t)
	if not t.refresh then return false end
	local ok, data, raw, code = requestJSON("POST", "https://securetoken.googleapis.com/v1/token?key=" .. t.key,
		"grant_type=refresh_token&refresh_token=" .. enc(t.refresh), { ["Content-Type"] = "application/x-www-form-urlencoded" })
	if ok and type(data) == "table" and data.id_token then
		applyToken(t, data.id_token, data.refresh_token, data.user_id, data.expires_in)
		saveSession(t)
		return true
	end
	t.err = errText(data, raw)
	-- only a definite "this login is dead" answer discards the saved login; network hiccups keep it
	if code == 400 then t.refresh = nil end
	return false
end

-- Make sure t.token is valid. Single-flight: parallel callers wait for ONE login instead of each signing up.
-- force=true + badToken: the server rejected badToken, so renew (unless someone already did).
function ensureToken(t, force, badToken)
	if not force and t.token and os.time() < t.exp then return true end
	local waited = 0
	while t.busy and waited < 20 do task.wait(0.1); waited = waited + 0.1 end
	if force and t.token and t.token ~= badToken and os.time() < t.exp then return true end
	if not force and t.token and os.time() < t.exp then return true end
	t.busy = true
	if not t.loaded then t.loaded = true; loadSession(t) end
	local ok = false
	for attempt = 1, 4 do
		if t.refresh then
			if refreshTok(t) then ok = true; break end
		end
		if not t.refresh then
			if signUp(t) then ok = true; break end
		end
		task.wait(0.5 * attempt)
	end
	t.busy = false
	return ok
end

