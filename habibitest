        end
    end)
end

local busy = false

local function search()
    if busy then return end

    local query = searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then
        status.Text = "Please enter a search term."
        return
    end

    busy = true
    searchButton.Text = "..."
    clearResults()
    status.Text = "Searching YouTube..."

    local endpoint = "https://www.googleapis.com/youtube/v3/search"
        .. "?part=snippet"
        .. "&type=video"
        .. "&maxResults=10"
        .. "&q=" .. urlEncode(query)
        .. "&key=" .. urlEncode(API_KEY)

    task.spawn(function()
        local ok, response = pcall(function()
            return requestFunc({
                Url = endpoint,
                Method = "GET",
                Headers = { ["Accept"] = "application/json" }
            })
        end)

        if not gui.Parent then return end

        if not ok or not response then
            status.Text = "Network request failed."
            busy = false
            searchButton.Text = "SEARCH"
            return
        end

        local code = response.StatusCode or response.Status or 0
        if code < 200 or code >= 300 then
            local message = "YouTube API error: HTTP " .. tostring(code)
            local decodedOk, body = pcall(function()
                return HttpService:JSONDecode(response.Body or "{}")
            end)
            if decodedOk and body.error and body.error.message then
                message = body.error.message
            end
            status.Text = message
            busy = false
            searchButton.Text = "SEARCH"
            return
        end

        local decodedOk, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not decodedOk or type(data) ~= "table" then
            status.Text = "Could not read YouTube response."
            busy = false
            searchButton.Text = "SEARCH"
            return
        end

        local count = 0
        for _, item in ipairs(data.items or {}) do
            if item.id and item.id.videoId then
                count += 1
                createResult(count, item)
            end
        end

        if count == 0 then
            status.Text = "No videos found."
        else
            status.Text = "Showing " .. count .. " video results."
        end

        busy = false
        searchButton.Text = "SEARCH"
    end)
end

searchButton.MouseButton1Click:Connect(search)
searchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then search() end
end)

-- Drag window by its header
local dragging = false
local dragStart, startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

