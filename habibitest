-- Helpers
local function urlEncode(str)
    return str:gsub("([^%w%-%.%_%~])", function(c)
        return string.format("%%%02X", c:byte())
    end)
end

local function httpGet(url)
    local s, res = pcall(function() return req({Url = url, Method = "GET"}) end)
    if s and res and res.Body then return res.Body end
    return nil
end

local function playAudio(filePath, title)
    if activeSound then
        pcall(function() activeSound:Stop(); activeSound:Destroy() end)
    end
    
    statusLabel.Text = "Status: Loading asset..."
    local asset = getasset(filePath)
    
    local sound = Instance.new("Sound")
    sound.SoundId = asset
    sound.Volume = 0.8
    sound.Parent = workspace
    sound:Play()
    activeSound = sound
    
    statusLabel.Text = "Status: Playing '" .. tostring(title):sub(1, 25) .. "'"
end

-- Download pipeline using savenow.to (from your original script)
local function downloadAndPlay(ytUrl)
    statusLabel.Text = "Status: Requesting conversion..."
    local api = "https://p.savenow.to/ajax/download.php?url=" .. urlEncode(ytUrl) .. "&format=mp3&apikey=21fbd971d02303568cf35043e7993dafc4ddf260"
    
    local body = httpGet(api)
    if not body then
        statusLabel.Text = "Status: Error - API failed"
        return
    end
    
    local s, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not s or not data or not data.id then
        statusLabel.Text = "Status: Error - Bad JSON response"
        return
    end
    
    local downloadId = data.id
    statusLabel.Text = "Status: Converting (0%)..."
    
    local audioUrl = nil
    for i = 1, 60 do
        task.wait(2)
        local progBody = httpGet("https://p.savenow.to/ajax/progress.php?id=" .. downloadId)
        if progBody then
            local pS, pD = pcall(function() return HttpService:JSONDecode(progBody) end)
            if pS and pD then
                local prog = tonumber(pD.progress) or 0
                statusLabel.Text = "Status: Converting (" .. math.clamp(math.floor(prog), 0, 100) .. "%)"
                if prog >= 1000 and pD.download_url then
                    audioUrl = pD.download_url
                    break
                end
            end
        end
    end
    
    if not audioUrl then
        statusLabel.Text = "Status: Error - Conversion timeout"
        return
    end
    
    statusLabel.Text = "Status: Downloading MP3..."
    local mp3Res = req({Url = audioUrl, Method = "GET"})
    if not mp3Res or not mp3Res.Body then
        statusLabel.Text = "Status: Error - Failed to download payload"
        return
    end
    
    local fileName = FOLDER_NAME .. "tat_" .. downloadId .. ".mp3"
    writefile(fileName, mp3Res.Body)
    playAudio(fileName, data.title or "YouTube Audio")
end

-- Check local storage cache first before downloading
local function processTrack(ytUrl)
    -- Check if cached locally
    local cachedFile = nil
    for _, file in ipairs(listfiles(FOLDER_NAME)) do
        if file:match("%.mp3$") then
            cachedFile = file -- Uses local cache
            break
        end
    end
    
    -- For precise matching or simple execution, let's run download pipeline if not cached
    if cachedFile and ytUrl:find("watch") then
        statusLabel.Text = "Status: Loaded from local cache (Instant)!"
        playAudio(cachedFile, "Cached Track")
    else
        downloadAndPlay(ytUrl)
    end
end

-- Firebase Sync Polling (Syncs between your 2 test accounts in this server)
local lastTimestamp = 0
task.spawn(function()
    while screenGui.Parent do
        task.wait(3)
        local body = httpGet(FIREBASE_URL)
        if body and body ~= "null" then
            local s, parsed = pcall(function() return HttpService:JSONDecode(body) end)
            if s and parsed and parsed.song then
                if parsed.song.timestamp and parsed.song.timestamp > lastTimestamp then
                    lastTimestamp = parsed.song.timestamp
                    processTrack(parsed.song.url)
                end
            end
        end
    end
end)

local function broadcastToFirebase(ytUrl)
    local payload = HttpService:JSONEncode({
        url = ytUrl,
        timestamp = os.time()
    })
    pcall(function()
        req({
            Url = FIREBASE_URL,
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
end

